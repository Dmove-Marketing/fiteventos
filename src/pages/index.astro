---
import Base from "../layouts/Base.astro";
import config from "../../config.json";
import Img from "../components/ui/Img.astro";
import LeadForm from "../components/forms/LeadForm.astro";
import "../styles/institucional.css";
---

<Base
  title="Espaço Fit Eventos – São Paulo"
  description="O espaço ideal para eventos que exigem excelência. 16 ambientes, gastronomia assinada e tecnologia integrada em São Paulo."
  ogImage="/images/novo_logo.png"
>
  <!-- HEADER -->
  <header id="header">
    <div class="container">
      <div class="header-inner">
        <a href="#hero" class="logo">
          <Img
            src="logo.fiteventos.webp"
            alt="Espaço Fit Eventos"
            class="logo-img"
            priority
          />
        </a>
        <nav id="nav">
          <a href="/" class="nav-active">Home</a>
          <a href="/quem-somos/">Quem Somos</a>
          <a href="/eventos-corporativos/">Corporativo</a>
          <a href="/social/">Social</a>
          <a href="#contato">Contato</a>
          <a href="#contato" class="nav-cta">Orçamento</a>
        </nav>
        <div class="hamburger" id="hamburger">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </header>

  <!-- MOBILE MENU OVERLAY -->
  <div id="mobile-menu">
    <button id="mobile-close" aria-label="Fechar menu">✕</button>
    <a href="/">Home</a>
    <a href="/quem-somos/">Quem Somos</a>
    <a href="/eventos-corporativos/">Corporativo</a>
    <a href="/social/">Social</a>
    <a href="#contato">Contato</a>
    <a href="#contato" class="nav-cta">Orçamento</a>
  </div>

  <!-- HERO -->
  <section id="hero">
    <div class="hero-slides">
      <div class="hero-slide active">
        <Img src="galeria-pr.institucional08.webp" alt="" class="hero-slide-img" priority />
      </div>
      <div class="hero-slide">
        <Img src="galeria-pr.institucional19.webp" alt="" class="hero-slide-img" />
      </div>
      <div class="hero-slide">
        <Img src="corporativos-atualizada.webp" alt="" class="hero-slide-img" />
      </div>
      <div class="hero-slide">
        <Img src="galeria-pr.institucional06.webp" alt="" class="hero-slide-img" />
      </div>
    </div>
    <div class="hero-gradient"></div>
    <div class="hero-accent"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-eyebrow">
          <span>São Paulo · Desde 2012</span>
        </div>
        <h2>
          Múltiplos espaços em um <br /><em>único endereço</em>
        </h2>
        <div class="hero-actions">
          <a href="/eventos-corporativos/" class="btn btn-outline-white">
            Eventos Corporativos
          </a>
          <a href="/social/" class="btn btn-outline-white">
            Eventos Sociais
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- EMPRESA -->
  <section id="empresa">
    <div class="container">
      <div class="empresa-grid">
        <div class="empresa-visual reveal">
          <div class="empresa-video-wrap">
            <video autoplay muted loop playsinline>
              <source src="https://media.dmove.com.br/clients/espacofitcom/videos/video_sobre-fiteventos.webm" type="video/webm" />
            </video>
          </div>
        </div>
        <div class="empresa-text reveal">
          <span class="label">Sobre o espaço</span>
          <h2>
            Uma trajetória <br />
            <em style="font-style:normal; color:var(--rose)">de sucesso</em>
          </h2>
          <p>
            Desde 2012, o Espaço Fit Eventos transforma encontros corporativos e
            sociais em experiências bem executadas, unindo estrutura, tecnologia e
            atendimento de excelência em uma operação preparada para os mais
            diversos formatos de evento.
          </p>
          <a href="/quem-somos/" class="btn btn-primary">
            Saiba Mais
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENTOS -->
  <section id="eventos">
    <div class="container">
      <div class="eventos-header reveal">
        <span class="label">VERSATILIDADE</span>
        <h2>
          ESPAÇOS MÚLTIPLOS PARA EVENTOS<br /><span class="accent-rose"
            >ÚNICOS E EXCLUSIVO</span
          >
        </h2>
      </div>
    </div>
    <div class="container">
      <div class="eventos-cards reveal">
        <div class="evento-card">
          <div class="evento-card-img">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/home_card-eventos-corporativos.webp" alt="Eventos Corporativos" />
          </div>
          <div class="evento-card-overlay"></div>
          <div class="evento-card-content">
            <span class="evento-badge">01</span>
            <div class="evento-card-bottom">
              <h3>EVENTOS CORPORATIVOS</h3>
              <a
                href="https://www.instagram.com/espacofiteventos/"
                target="_blank"
                rel="noopener"
                class="evento-btn"
              >
                VEJA MAIS
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                >
              </a>
            </div>
          </div>
        </div>
        <div class="evento-card">
          <div class="evento-card-img">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/home_card-eventos-sociais.webp" alt="Eventos Sociais" />
          </div>
          <div class="evento-card-overlay"></div>
          <div class="evento-card-content">
            <span class="evento-badge">02</span>
            <div class="evento-card-bottom">
              <h3>EVENTOS SOCIAIS</h3>
              <a
                href="https://www.instagram.com/espacofit.eventos/"
                target="_blank"
                rel="noopener"
                class="evento-btn"
              >
                VEJA MAIS
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
                >
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="eventos-cta reveal">
        <a href="#contato" class="btn btn-pill-rose">
          SOLICITAR ORÇAMENTO
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>


  <!-- PARCEIROS -->
  <section id="parceiros">
    <div class="parceiros-head reveal">
      <span class="label">Parceiros</span>
      <h2><em style="font-style:normal; font-weight:700; color:var(--rose)">Clientes</em></h2>
    </div>
    <div class="parceiros-grid reveal">
