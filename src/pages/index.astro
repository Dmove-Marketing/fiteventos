<style>
  #eventos {
    background: #fafafa !important;
    padding: 80px 0 !important;
  }

  #eventos .eventos-header {
    text-align: center !important;
    margin-bottom: 50px !important;
  }

  #eventos .eventos-header .label {
    color: var(--rose, #c22055) !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 0.15em !important;
    text-transform: uppercase !important;
    display: block !important;
    margin-bottom: 12px !important;
  }

  #eventos .eventos-header h2 {
    font-size: clamp(24px, 2.8vw, 36px) !important;
    font-weight: 300 !important;
    color: #111 !important;
    line-height: 1.25 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
  }

  #eventos .eventos-header h2 .accent-rose {
    color: var(--rose, #c22055) !important;
    font-weight: 700 !important;
  }

  #eventos .eventos-cards {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 32px !important;
    max-width: 960px !important;
    margin: 0 auto !important;
  }

  #eventos .evento-card {
    position: relative !important;
    overflow: hidden !important;
    border-radius: 20px !important;
    height: 420px !important;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14) !important;
    transition: transform 0.4s ease, box-shadow 0.4s ease !important;
  }

  #eventos .evento-card:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.22) !important;
  }

  #eventos .evento-card-img {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  #eventos .evento-card-img img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1) !important;
  }

  #eventos .evento-card:hover .evento-card-img img {
    transform: scale(1.06) !important;
  }

  #eventos .evento-card-overlay {
