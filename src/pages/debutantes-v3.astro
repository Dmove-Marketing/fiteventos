---
// Gerado a partir de: debutantes.html
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import StoriesReels from '../components/ui/StoriesReels.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/debutantes-v2.css';

// LCP do hero: uma única <picture> — mobile = recorte vertical, desktop = foto
// horizontal — cada uma em algumas larguras (srcset). Os preloads usam os
// mesmos srcsets, então o navegador baixa UMA imagem, no tamanho certo p/ a tela.
import heroDesktopSrc from '../assets/images/abertura-debutantes.jpg';
import heroMobileSrc from '../assets/images/abertura-debutantes-mobile.jpg';
const heroDesktop = await getImage({ src: heroDesktopSrc, widths: [1280, 1920, 2560], quality: 80 });
const heroMobile = await getImage({ src: heroMobileSrc, widths: [640, 828, 1080], quality: 78 });
---

<Base
  title="Debutantes – Espaço Fit Eventos"
  description="Realize a festa de 15 anos dos seus sonhos no Espaço Fit Eventos. Ambientes exclusivos, gastronomia assinada e toda a estrutura para uma noite inesquecível em São Paulo."
  ogImage="/images/novo_logo.png"
  waHideEmail={true}
  waFixedTipoEvento="Aniversario debutante"
>
  <Fragment slot="head">
    <link rel="preload" as="image" imagesrcset={heroMobile.srcSet.attribute} imagesizes="100vw" media="(max-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset={heroDesktop.srcSet.attribute} imagesizes="100vw" media="(min-width: 769px)" fetchpriority="high" />
    <!-- Fontes (só v3): os pesos 500 e 600 reaproveitam os arquivos do 400 e do
         700, que a página já baixa — 2 downloads de ~36KB a menos. Fica no slot
         "head", depois dos @font-face do Base, então estas regras prevalecem -->
    <style is:inline>
      @font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/Inter-400-latin.s.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/Inter-700-latin.s.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    </style>
  </Fragment>

    <section class="hero">
        <div id="hero-slides">
            <!-- <picture> em vez de <Img>: precisa de "art direction" (outra foto no mobile) -->
            <div class="hero-slide active">
                <picture>
                    <source media="(max-width: 768px)" srcset={heroMobile.srcSet.attribute} sizes="100vw" width="1080" height="1920" />
                    <img src={heroDesktop.src} srcset={heroDesktop.srcSet.attribute} sizes="100vw" width="2560" height="1438" alt="" loading="eager" fetchpriority="high" decoding="async" />
                </picture>
            </div>
        </div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-logo">
                <Img src="b6141e8a-26b2-4a98-a24a-572b061dd41b.png" alt="Espaço Fit Eventos" width={480} priority />
            </div>
            <h1 class="hero-title">Sua festa de 15 anos<br><em>com personalidade</em></h1>
            <div class="hero-actions">
                <a href="#contato" class="btn-primary">Solicitar contato</a>
            </div>
        </div>
    </section>


    <section class="sobre">
        <!-- Desktop: vídeo horizontal (v2) -->
        <div class="sobre-media sobre-media--d">
            <Video src="https://lp.espacofiteventos.com.br/video.debutantes.mp4" poster="" title="Conheça o Espaço Fit Eventos" description="Um tour pelo espaço de festa de 15 anos do Espaço Fit Eventos." uploadDate="2026-05-18" duration="PT2M42S" />
        </div>
        <!-- Mobile: Stories vertical -->
        <div class="sobre-media sobre-media--m">
            <StoriesReels
              poster="https://lp.espacofiteventos.com.br/reels/poster.jpg"
              title="Conheça o Espaço Fit Eventos"
              aspect="9 / 16"
              clips={[
                { src: 'https://lp.espacofiteventos.com.br/reels/clip1.mp4' },
                { src: 'https://lp.espacofiteventos.com.br/reels/clip2.mp4' },
                { src: 'https://lp.espacofiteventos.com.br/reels/clip3.mp4' },
                { src: 'https://lp.espacofiteventos.com.br/reels/clip4.mp4' },
                { src: 'https://lp.espacofiteventos.com.br/reels/clip5.mp4' },
              ]}
            />
        </div>
        <div class="sobre-content" style="opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s">
            <span class="section-tag">Sobre o espaço</span>
            <h2 class="section-title">Detalhes pensados <em>para você brilhar</em></h2>
            <p class="section-body">Para <b>50 a 530 convidados</b>, cada ambiente acompanha um momento da noite, do primeiro brinde à última música. E o pé-direito alto dá à debutante liberdade para ousar na cenografia e criar o cenário que sempre sonhou.</p>
            <a href="#contato" class="btn-primary sobre-cta">Solicitar contato</a>
        </div>
    </section>

    <section class="ambientes" id="ambientes">
        <div class="ambientes-header">
            <span class="section-tag">Espaço · Projeção mapeada<span class="hide-m"> · </span><br class="br-m">Painéis de LED</span>
            <h2 class="section-title">Um espaço completo <em>para uma festa única</em></h2>
            <p class="ambientes-desc">Ambientes amplos que se adaptam ao seu tema, com projeção mapeada e painéis de LED que levam a festa para onde você imaginar.</p>
            <p class="ambientes-desc-m">Ambientes amplos, projeção mapeada e painéis de LED.</p>
        </div>
        <div class="ambientes-carousel">
        <button class="ambientes-btn ambientes-btn--prev" id="ambientesPrev" type="button" aria-label="Foto anterior">&lsaquo;</button>
        <div class="ambientes-grid" id="ambientesGrid">
            <div class="ambientes-item"><Img src="2DECOR_1145_DSC07536_resultado.avif" alt="Bolo de 15 anos com painel floral e letreiro personalizado" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-07.jpg" alt="Salão com projeção mapeada temática de Las Vegas" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-02.jpg" alt="Cenário com balões dourados e painel floral" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-06.jpg" alt="Salão com projeção mapeada rosé e mesas decoradas" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-08.jpg" alt="Salão com projeção mapeada temática da Toscana" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-09.jpg" alt="Cenário com balões azuis e borboletas suspensas" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-01.jpg" alt="Salão com projeção mapeada em tons dourados e mesas decoradas" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="camarim.fit.webp" alt="Debutante se arrumando no camarim" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-04.jpg" alt="Salão com projeção mapeada em tons laranja e mesas decoradas" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="espaco-completo-03.jpg" alt="Pista de LED com projeção mapeada de mármore verde" width={800} quality={72} zoom /></div>
            <div class="ambientes-item"><Img src="2DECOR_1065_RICK6217-31-03-2026-13-26-01_resultado.avif" alt="Painéis de LED exibindo uma cidade à noite" width={1024} quality={72} zoom /></div>
        </div>
        <button class="ambientes-btn ambientes-btn--next" id="ambientesNext" type="button" aria-label="Próxima foto">&rsaquo;</button>
        </div>
    </section>

    <section class="gastro-v3" id="gastronomia">
        <div class="gastro-v3-header">
            <span class="section-tag">Gastronomia</span>
            <h2 class="section-title">Uma experiência gastronômica <em>à altura da sua noite</em></h2>
            <p class="section-body gastro-v3-sub">Menus autorais com a assinatura do premiado Chef Dalton Rangel.</p>
        </div>
        <div class="gastro-v3-carousel">
            <button class="gastro-v3-btn gastro-v3-btn--prev" id="gastroPrev" type="button" aria-label="Foto anterior">&lsaquo;</button>
            <div class="gastro-v3-track" id="gastroTrack">
                <div class="gastro-v3-item"><Img src="gastronomia-v3-02.jpg" alt="Espetinhos gourmet servidos em cumbucas" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia-v3-04.jpg" alt="Bolinhos finalizados em bandeja dourada" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia-v3-05.jpg" alt="Prato de camarão com limão servido no réchaud" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia.debutantes02.jpg" alt="Pipoca gourmet servida em embalagem temática" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia-v3-01.jpg" alt="Mesa de buffet com petiscos e arranjos florais" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia.debutantes04.jpg" alt="Drinks servidos em bandeja espelhada" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia-v3-06.jpg" alt="Bolinhos servidos à mesa com louça fina" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia.debutantes06.jpg" alt="Mesa de buffet decorada com flores" width={800} quality={72} zoom /></div>
                <div class="gastro-v3-item"><Img src="gastronomia.debutantes05.jpg" alt="Convidada pegando pipoca gourmet" width={800} quality={72} zoom /></div>
            </div>
            <button class="gastro-v3-btn gastro-v3-btn--next" id="gastroNext" type="button" aria-label="Próxima foto">&rsaquo;</button>
        </div>
        <!-- Mobile: miniaturas (montadas pelo script a partir das fotos acima) -->
        <div class="gastro-v3-thumbs" id="gastroThumbs" aria-label="Miniaturas das fotos"></div>
    </section>

    <section class="depoimentos" style="opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s">
        <div class="depoimentos-header">
            <span class="section-tag">Depoimentos</span>
            <h2 class="section-title">Momentos especiais contados por quem já <br><em>celebrou no Fit Eventos</em></h2>
        </div>
        <div class="dep-carousel">
            <button class="dep-btn dep-btn-prev" id="depPrev" aria-label="Anterior">&lsaquo;</button>
            <div class="dep-track" id="depTrack">
                <div class="dep-card">
                    <p class="dep-card-text">Lugar muito bonito e organizado. Funcionários atenciosos. E as comidas e bebidas são top!</p>
                    <span class="dep-card-author">Wladimir Monteiro</span>
                </div>
                <div class="dep-card">
                    <p class="dep-card-text">Muito bom, confortável, oferece os recursos necessários e, muito bem localizado, com fácil acesso. Tanto para quem está em SP, quanto pra quem vem dos interiores.</p>
                    <span class="dep-card-author">Valdemar Fernandes</span>
                </div>
                <div class="dep-card">
                    <p class="dep-card-text">Perfeito espaço. Salas mega equipadas, equipe muito gentil e preparada, destaque para o Vicente, Daniel, Paula, Jamile e Vitória. Que comida maravilhosa! Tudo muito bom. Indico demais.</p>
                    <span class="dep-card-author">Aila Santana</span>
                </div>
                <div class="dep-card">
                    <p class="dep-card-text">O evento no Espaço Fit Eventos foi sensacional, os profissionais são excelentes e a comida que forneceram foi muito bom também.</p>
                    <span class="dep-card-author">Gislaine Geisger</span>
                </div>
                <div class="dep-card">
                    <p class="dep-card-text">Fiquei impressionada com a organização e excelência de cada pessoa que me atendeu! Existe um padrão na excelência e no atendimento!</p>
                    <span class="dep-card-author">Renata Palmutti</span>
                </div>
                <div class="dep-card">
                    <p class="dep-card-text">Maravilhosos! Antes, durante e depois do evento. Parabéns equipe!</p>
                    <span class="dep-card-author">Milena Guimarães</span>
                </div>
                <div class="dep-card">
                    <p class="dep-card-text">Lugar muito aconchegante, excelente para eventos. Top!</p>
                    <span class="dep-card-author">Karina Melo</span>
                </div>
                <div class="dep-card">
                    <p class="dep-card-text">O Espaço Fit tem uma ótima estrutura para realização de eventos, tamanhos/formatos diversos de salas, equipe prestativa e profissional, recomendo! Aprovado!</p>
                    <span class="dep-card-author">Pedro Costa</span>
                </div>
            </div>
            <button class="dep-btn dep-btn-next" id="depNext" aria-label="Próximo">&rsaquo;</button>
        </div>
    </section>

    <div class="galeria-header" id="galeria"
        style="opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s">
        <span class="section-tag">Inspirações</span>
        <h2 class="section-title">Veja como sua festa<br class="br-xs"> de 15 anos<br><em>pode ganhar vida</em></h2>
        <p class="section-body galeria-sub">Cada festa é única. Inspire-se para criar a sua.</p>
    </div>

    <!-- Fileiras justificadas: --r = largura/altura da foto; cada fileira soma ~5
         (horizontal = 1.5, vertical = 0.667) p/ todas terem altura parecida -->
    <div class="galeria">
        <div class="galeria-row">
            <div class="galeria-item" style="--r: 1.5"><Img src="hero_carrossel.01.jpg" alt="Debutante ao lado do bolo de 15 anos, em frente ao painel de flores" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 0.667"><Img src="galeria-v3-04.jpg" alt="Debutante com vestido verde ao lado do bolo de 15 anos" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="5FES_2825_RICK7651_resultado-1024x684.avif" alt="Convidados dançando na pista de LED com show de passistas" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="hero_carrossel.04.webp" alt="Debutante e acompanhante dançando na pista de LED" width={800} quality={72} zoom /></div>
        </div>
        <div class="galeria-row">
            <div class="galeria-item" style="--r: 1.5"><Img src="galeria-v3-01.jpg" alt="Debutante com vestido dourado em cenário iluminado" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="espaco-completo-05.jpg" alt="Casal dançando na pista de LED com projeção de mármore verde" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 0.667"><Img src="galeria-v3-02.jpg" alt="Debutante com vestido pink em frente ao jardim vertical" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="3RECEP_1620_RICK6734_resultado.avif" alt="Recepção de debutante" width={800} quality={72} zoom /></div>
        </div>
        <div class="galeria-row">
            <div class="galeria-item" style="--r: 1.5"><Img src="hero_carrossel.06.webp" alt="Valsa da debutante na pista iluminada" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 0.667"><Img src="galeria-v3-03.jpg" alt="Debutante com vestido vermelho sob projeção mapeada temática da Itália" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="hero_carrossel.02.webp" alt="Debutante ao lado do bolo de 15 anos" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="1MKOF_1129_RICK6291_resultado.avif" alt="Momento da festa" width={800} quality={72} zoom /></div>
        </div>
        <div class="galeria-row">
            <div class="galeria-item" style="--r: 0.667"><Img src="galeria-v3-05.jpg" alt="Debutante com vestido preto sob projeção mapeada de Las Vegas" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="hero_carrossel.05.webp" alt="Debutante e convidados aplaudindo em volta do bolo" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 0.667"><Img src="2DECOR_1075_RICK6232_resultado.avif" alt="Decoração de festa" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 1.5"><Img src="hero_carrossel.03.webp" alt="Debutante e família aplaudindo ao lado do bolo" width={800} quality={72} zoom /></div>
            <div class="galeria-item" style="--r: 0.667"><Img src="galeria-v3-06.jpg" alt="Debutante com vestido verde de veludo na pista de LED" width={800} quality={72} zoom /></div>
        </div>
    </div>

    <section class="contato-section" id="contato">
        <div class="contato-info" style="opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s">
            <div class="contato-intro">
                <span class="section-tag">Próximo passo</span>
                <h2 class="section-title">Vamos começar a planejar<br><em>sua festa dos sonhos?</em></h2>
                <p class="section-body">Preencha os dados e retornamos com disponibilidade, valores e as melhores opções para a sua noite.</p>
            </div>
            <ul class="contato-list">
                <li>
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Retorno rápido, com disponibilidade e valores</span>
                </li>
                <li>
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Convite para conhecer o espaço pessoalmente</span>
                </li>
                <li>
                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Atendimento humano e sem compromisso</span>
                </li>
            </ul>
            <a class="contato-wpp" href="https://wa.me/551132620819" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                <span>Prefere falar agora? <b>Chamar no WhatsApp</b></span>
            </a>
        </div>
        <div class="contato-form-wrap"
            style="opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s">
            <LeadForm
              formId="lead-form"
              project={config.project_slug}
              submitUrl={config.forms['lead-form'].webhooks[0]}
              redirectUrl="https://wa.me/551132620819"
              submitText="Enviar solicitação"
              footerText="Seus dados são usados apenas para retorno de contato e orçamento."
              honeypot
              fields={[
                { name: 'nome', type: 'text', label: 'Nome', placeholder: 'Ex.: Maria Silva', required: true },
                { name: 'telefone', type: 'tel', label: 'WhatsApp', placeholder: '(11) 9 0000-0000', required: true },
                { type: 'row', fields: [
                  { name: 'data_evento', type: 'text', label: 'Data do Evento', placeholder: 'dd/mm/aaaa', required: true, readonly: true, flatpickr: true },
                  { name: 'convidados', type: 'number', label: 'Nº de Convidados', placeholder: 'Ex.: 150', required: true }
                ]},
                { name: 'detalhes_adicionais', type: 'textarea', label: 'Mensagem', placeholder: 'Detalhes adicionais (não obrigatório)', required: false },
                { name: 'tipo_evento', type: 'hidden', value: 'Aniversario debutante' },
              ] as any}
            />
        </div>
    </section>

    <footer>
        <div class="footer-bottom">
            <p class="footer-copy">&copy; 2026 Espaço Fit Eventos — Todos os direitos reservados.</p>
            <a href="/" class="footer-logo-bottom" aria-label="Espaço Fit Eventos">
                <Img src="b6141e8a-26b2-4a98-a24a-572b061dd41b.png" alt="Espaço Fit Eventos" />
            </a>
            <div class="footer-dev">
                <span class="footer-dev-text">Desenvolvido por:</span>
                <a href="http://dmove.com.br" target="_blank" rel="noopener noreferrer">
                    <Img src="dmove-marketing-texto.png" alt="DMove" class="footer-dev-img" />
                </a>
            </div>
        </div>
    </footer>

    <!-- Visualizador de fotos em tela cheia (preenchido pelo script abaixo) -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Visualizador de fotos" hidden>
        <button class="lightbox-close" type="button" aria-label="Fechar">&times;</button>
        <button class="lightbox-nav lightbox-prev" type="button" aria-label="Foto anterior">&lsaquo;</button>
        <img class="lightbox-img" alt="" />
        <button class="lightbox-nav lightbox-next" type="button" aria-label="Próxima foto">&rsaquo;</button>
        <span class="lightbox-count" aria-live="polite"></span>
    </div>
</Base>
<script>
  import '../scripts/debutantes-v2.js';

  const byId = (id: string) => document.getElementById(id);

  // ── Carrosséis (v3): cada clique nas setas rola uma foto (item + gap)
  function setupCarousel(track: HTMLElement | null, prev: HTMLElement | null, next: HTMLElement | null) {
    if (!track) return;
    const step = () => {
      const item = track.firstElementChild as HTMLElement | null;
      return (item?.offsetWidth ?? 0) + (parseFloat(getComputedStyle(track).columnGap) || 0);
    };
    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  }
  setupCarousel(byId('gastroTrack'), byId('gastroPrev'), byId('gastroNext'));

  setupCarousel(byId('ambientesGrid'), byId('ambientesPrev'), byId('ambientesNext'));

  // ── Galeria "foto grande + miniaturas" (Gastronomia no mobile): tocar na
  // miniatura, nas setas ou deslizar na foto grande troca a foto. No desktop o
  // CSS ignora o estado "ativo" e a mesma trilha segue como carrossel
  function setupThumbGallery(track: HTMLElement | null, thumbsEl: HTMLElement | null, prev: HTMLElement | null, next: HTMLElement | null) {
    if (!track || !thumbsEl) return;
    const items = [...track.children] as HTMLElement[];
    if (!items.length) return;
    let current = 0;

    const thumbs = items.map((item, i) => {
      const img = item.querySelector('img');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'gallery-thumb';
      btn.setAttribute('aria-label', `Ver foto ${i + 1}: ${img?.alt ?? ''}`);
      if (img) {
        const t = document.createElement('img');
        t.src = img.getAttribute('src') ?? '';
        t.alt = '';
        t.loading = 'lazy';
        btn.appendChild(t);
      }
      btn.addEventListener('click', () => select(i));
      thumbsEl.appendChild(btn);
      return btn;
    });

    function select(i: number) {
      current = (i + items.length) % items.length;
      items.forEach((el, k) => el.classList.toggle('is-active', k === current));
      thumbs.forEach((t, k) => {
        t.classList.toggle('is-active', k === current);
        t.setAttribute('aria-current', k === current ? 'true' : 'false');
      });
      // centraliza a miniatura ativa na faixa (sem rolar a página)
      const t = thumbs[current];
      thumbsEl!.scrollTo({ left: t.offsetLeft - (thumbsEl!.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
    }
    select(0);

    prev?.addEventListener('click', () => select(current - 1));
    next?.addEventListener('click', () => select(current + 1));

    let startX = 0;
    track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) select(current + (dx < 0 ? 1 : -1));
    });
  }
  setupThumbGallery(byId('gastroTrack'), byId('gastroThumbs'), byId('gastroPrev'), byId('gastroNext'));

  // ── Visualizador de fotos: clicar numa foto de "Espaço completo", Gastronomia
  // ou Galeria abre em tela cheia; setas, teclado e swipe passam para a
  // anterior/próxima da mesma seção
  (() => {
    const lb = byId('lightbox');
    if (!lb) return;
    const lbImg = lb.querySelector<HTMLImageElement>('.lightbox-img')!;
    const counter = lb.querySelector<HTMLElement>('.lightbox-count')!;
    const closeBtn = lb.querySelector<HTMLButtonElement>('.lightbox-close')!;
    const lenis = (window as any).__lenis;
    let list: HTMLImageElement[] = [];
    let index = 0;
    let lastFocus: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + list.length) % list.length;
      const img = list[index];
      lbImg.src = img.dataset.full || img.currentSrc || img.src;
      lbImg.alt = img.alt;
      counter.textContent = `${index + 1} / ${list.length}`;
    };
    const open = (imgs: HTMLImageElement[], i: number) => {
      list = imgs;
      lastFocus = document.activeElement as HTMLElement | null;
      show(i);
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      lenis?.stop();
      closeBtn.focus();
    };
    const close = () => {
      lb.hidden = true;
      lbImg.removeAttribute('src');
      document.documentElement.style.overflow = '';
      lenis?.start();
      lastFocus?.focus();
    };

    ['.ambientes-item', '.gastro-v3-item', '.galeria-item'].forEach((sel) => {
      const items = [...document.querySelectorAll<HTMLElement>(sel)];
      const imgs = items.map((el) => el.querySelector('img')).filter((img): img is HTMLImageElement => !!img);
      items.forEach((el, i) => {
        el.setAttribute('role', 'button');
        el.tabIndex = 0;
        el.setAttribute('aria-label', `Ampliar foto: ${imgs[i]?.alt ?? ''}`);
        el.addEventListener('click', () => open(imgs, i));
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(imgs, i); }
        });
      });
    });

    lb.querySelector('.lightbox-prev')?.addEventListener('click', () => show(index - 1));
    lb.querySelector('.lightbox-next')?.addEventListener('click', () => show(index + 1));
    closeBtn.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    lb.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    });
  })();
</script>

<style>
  /* Overrides só da v3 — o CSS base (debutantes-v2.css) é compartilhado com a v2 */

  /* <picture> do hero não cria caixa própria: o <img> segue ocupando o slide */
  .hero-slide picture {
    display: contents;
  }

  /* Hero sem menu fixo: o logo entra no hero, no lugar da tag.
     Respiro maior que o do título→tag p/ o logo ler como assinatura */
  .hero-logo {
    margin-bottom: 40px;
  }

  /* filtro deixa o logo todo branco (o "FIT" original é magenta) */
  .hero-logo :global(img) {
    display: block;
    height: 36.5px;
    width: auto;
    filter: brightness(0) invert(1);
  }

  /* Título = base × 0,85 × 0,85 (duas reduções de 15% sobre
     clamp(24px, min(5vw, 5.8vh), 60px)); 40px até o CTA, o mesmo respiro
     do logo → título */
  .hero-title {
    font-size: clamp(17.34px, min(3.61vw, 4.19vh), 43.35px);
    margin-bottom: 40px;
  }

  /* Desktop/tablet: conteúdo na parte de baixo, título só com as quebras do
     HTML e degradê leve da esquerda p/ a direita, reforçando a leitura */
  @media (min-width: 769px) {
    /* Ancorado embaixo com 8vh de respiro: o centro do bloco fica em ~78% da
       altura da tela (~30% abaixo de quando era centralizado) */
    .hero {
      align-items: flex-end;
    }

    .hero-content {
      max-width: none;
      padding-top: 0;
      padding-bottom: 8vh;
    }

    /* Quebra só nos <br> (sem isso o título quebra sozinho em telas largas);
       fonte 10% menor que a base, que segue valendo no mobile */
    .hero-title {
      white-space: nowrap;
      font-size: clamp(15.61px, min(3.25vw, 3.77vh), 39.02px);
    }

    /* CTA do hero em contorno dourado (o bloco sólido competia com o título);
       preenche de dourado no hover */
    .hero .btn-primary {
      background: rgba(196, 156, 76, .12);
      border: 1px solid var(--dourado);
      color: var(--dourado-claro);
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 30px;
      font-size: 11px;
      letter-spacing: 2.5px;
      font-weight: 600;
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }

    .hero .btn-primary:hover {
      background: var(--dourado);
      color: var(--branco);
    }

    .hero-overlay {
      background:
        linear-gradient(to right, rgba(0, 0, 0, .45) 0%, rgba(0, 0, 0, .18) 35%, rgba(0, 0, 0, 0) 60%),
        linear-gradient(to top, rgba(0, 0, 0, .72) 0%, rgba(0, 0, 0, .30) 38%, rgba(0, 0, 0, 0) 68%);
    }
  }

  @media (max-width: 768px) {
    .hero-logo {
      margin-bottom: 16px;
    }

    .hero-logo :global(img) {
      height: 19.8px;
    }

    .hero-title {
      margin-bottom: 24px;
    }

    /* Conteúdo do hero centralizado (logo, título, tag e CTA) */
    .hero-content {
      width: 100%;
      text-align: center;
    }

    .hero-logo :global(img) {
      margin: 0 auto;
    }

    .hero-actions {
      align-items: center;
    }

    /* CTA mais compacto (caixa proporcional ao texto) e sem a seta */
    .hero .btn-primary {
      align-self: center;
      font-size: 13px;
      line-height: 1.3;
      padding: 10px 20px;
    }

    .hero .btn-primary::after {
      content: none;
    }
  }

  /* Seção "Sobre" no desktop: fundo bege contínuo, sem a linha dourada vertical
     e com o mesmo respiro de 40px embaixo que já existe em cima */
  @media (min-width: 769px) {
    .sobre {
      background: var(--dourado-bg);
      padding-bottom: 40px;
    }

    .sobre-content {
      border-left: none;
    }
  }

  /* CTA da "Sobre": mesmo tamanho/fonte do CTA do hero, mas dourado sólido
     com texto branco (sobre o fundo claro o bloco cheio não grita) */
  .sobre-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 30px;
    font-size: 11px;
    letter-spacing: 2.5px;
    font-weight: 600;
  }

  /* Sem a linha dourada horizontal entre "Sobre" e "Ambientes" (desktop e mobile) */
  .ambientes {
    border-top: none;
  }

  /* Sem as linhas douradas no topo do contato e do rodapé */
  .contato-section,
  footer {
    border-top: none;
  }

  /* "Desenvolvido por:" mais perto do logo da Dmove */
  .footer-dev {
    gap: 6px;
  }

  /* Contato no desktop: painel esquerdo em bege claro (no base é escuro), com
     textos e atalho do WhatsApp recoloridos p/ fundo claro. No mobile esse
     painel já é dissolvido no fundo branco, então nada muda lá */
  @media (min-width: 769px) {
    .contato-info {
      background: var(--dourado-bg);
      border-right: none;
    }

    .contato-info .section-title {
      color: var(--preto);
    }

    .contato-info .section-title em {
      color: var(--dourado);
    }

    .contato-info .section-body {
      color: #555;
    }

    .contato-list li {
      color: #444;
    }

    .contato-list svg {
      stroke: var(--dourado);
    }

    .contato-wpp {
      color: var(--preto);
      border-color: rgba(196, 156, 76, .45);
    }

    .contato-wpp:hover {
      background: rgba(196, 156, 76, .12);
      border-color: var(--dourado);
    }
  }

  /* Galeria em bege claro (cabeçalho + o fundo que aparece entre as fotos),
     sem a linha dourada no topo */
  .galeria-header {
    background: var(--dourado-bg);
    border-top: none;
  }

  .galeria {
    background: var(--dourado-bg);
  }

  /* Gastronomia (v3): só título + carrossel de fotos, em fundo bege.
     Desktop: 3 fotos por vez + setas; mobile: swipe com "peek" */
  .gastro-v3 {
    background: var(--dourado-bg);
    padding: 100px 60px;
    scroll-margin-top: 80px;
  }

  .gastro-v3-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .gastro-v3-header .section-title {
    margin-bottom: 16px;
  }

  .gastro-v3-sub {
    margin: 0 auto;
  }

  .gastro-v3-carousel {
    position: relative;
  }

  .gastro-v3-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .gastro-v3-track::-webkit-scrollbar {
    display: none;
  }

  .gastro-v3-item {
    flex: 0 0 calc((100% - 32px) / 3);
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
    overflow: hidden;
    background-color: var(--preto-medio);
  }

  .gastro-v3-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gastro-v3-btn,
  .ambientes-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--branco);
    color: var(--dourado-escuro);
    border: 1px solid rgba(196, 156, 76, .45);
    font-size: 20px;
    cursor: pointer;
    transition: background .3s, border-color .3s;
  }

  .gastro-v3-btn:hover,
  .ambientes-btn:hover {
    background: var(--dourado-bg2);
    border-color: var(--dourado);
  }

  .gastro-v3-btn--prev {
    left: -22px;
  }

  .gastro-v3-btn--next {
    right: -22px;
  }

  @media (max-width: 768px) {
    .gastro-v3 {
      padding: 56px 20px 64px;
    }

    .gastro-v3-header {
      margin-bottom: 26px;
    }

    .gastro-v3-track {
      gap: 12px;
      margin: 0 -20px;
      padding: 0 20px;
    }

    .gastro-v3-item {
      flex-basis: 82%;
      border-radius: 8px;
    }

    /* Setas também no mobile (menores, sobre a borda das fotos/cards) —
       gastronomia, "Espaço completo" e depoimentos */
    .gastro-v3-btn,
    .ambientes-btn,
    .dep-btn {
      display: flex;
      width: 36px;
      height: 36px;
      font-size: 18px;
      box-shadow: 0 2px 10px rgba(0, 0, 0, .15);
    }

    .gastro-v3-btn--prev,
    .ambientes-btn--prev,
    .dep-btn-prev {
      left: -12px;
    }

    .gastro-v3-btn--next,
    .ambientes-btn--next,
    .dep-btn-next {
      right: -12px;
    }
  }

  /* Depoimentos em fundo branco (no base é escuro): textos, cards e setas
     recoloridos p/ fundo claro; cards em bege p/ destacar do fundo.
     "Diferenciais" foi removida da v3 */
  .depoimentos {
    background: var(--branco);
  }

  .depoimentos-header .section-title {
    color: var(--preto);
  }

  .depoimentos-header .section-title em {
    color: var(--dourado);
  }

  .dep-card {
    background: var(--dourado-bg);
    border-color: rgba(196, 156, 76, .3);
  }

  .dep-card-text {
    color: #444;
  }

  .dep-card-author {
    color: var(--dourado-escuro);
  }

  .dep-btn {
    background: var(--branco);
    color: var(--dourado-escuro);
    border-color: rgba(196, 156, 76, .45);
  }

  .dep-btn:hover {
    background: rgba(196, 156, 76, .15);
    border-color: var(--dourado);
  }

  .galeria-header .section-title {
    margin-bottom: 16px;
  }

  .galeria-sub {
    margin: 0 auto;
  }

  /* Galeria em fileiras justificadas: cada fileira ocupa a largura toda e as
     fotos dela ficam com a mesma altura, na proporção original (--r no HTML).
     Sem corte e com o final sempre reto. Desktop: fileiras montadas no HTML.
     Mobile: as fileiras se desfazem e as fotos quebram linha sozinhas, todas
     visíveis (a última linha não estica) */
  .galeria {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .galeria-row {
    display: flex;
    gap: 3px;
  }

  .galeria-item {
    flex: var(--r) 1 0%;
    aspect-ratio: var(--r);
    min-width: 0;
  }

  .galeria-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .galeria {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 4px;
      overflow: visible;
      scroll-snap-type: none;
      padding: 0 20px 56px;
    }

    .galeria::after {
      content: '';
      flex: 999 1 0%;
    }

    .galeria-row {
      display: contents;
    }

    .galeria-item {
      flex: var(--r) 1 calc(var(--r) * 120px);
      aspect-ratio: var(--r);
      height: auto;
      border-radius: 4px;
      scroll-snap-align: none;
    }
  }

  /* Fotos clicáveis (abrem o visualizador) */
  .ambientes-item,
  .gastro-v3-item,
  .galeria-item {
    cursor: zoom-in;
  }

  /* Setas do carrossel de "Espaço completo": só no mobile (no desktop é grade) */
  .ambientes-carousel {
    position: relative;
  }

  @media (min-width: 769px) {
    .ambientes-btn {
      display: none;
    }
  }

  /* Mobile: sem o atalho retangular do WhatsApp e sem a linha de reforço (o
     botão flutuante do WhatsApp continua); respiro no fim do form */
  @media (max-width: 768px) {
    .contato-wpp,
    .contato-list {
      display: none;
    }

    .contato-form-wrap {
      padding-bottom: 40px;
    }
  }

  /* Visualizador de fotos em tela cheia */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 80px;
    background: rgba(10, 10, 10, .92);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 10px 40px rgba(0, 0, 0, .5);
  }

  .lightbox-close {
    position: absolute;
    top: 12px;
    right: 16px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--branco);
    font-size: 34px;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, .12);
    border: 1px solid rgba(255, 255, 255, .3);
    color: var(--branco);
    font-size: 26px;
    cursor: pointer;
    transition: background .2s;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, .24);
  }

  .lightbox-prev {
    left: 16px;
  }

  .lightbox-next {
    right: 16px;
  }

  .lightbox-count {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, .75);
    font-size: 12px;
    letter-spacing: 2px;
  }

  @media (max-width: 768px) {
    .lightbox {
      padding: 64px 12px 84px;
    }

    /* setas embaixo, fora da foto, p/ não cobrir o conteúdo */
    .lightbox-nav {
      top: auto;
      bottom: 16px;
      transform: none;
      width: 44px;
      height: 44px;
    }

    .lightbox-count {
      bottom: 30px;
    }
  }

  /* "Espaço completo" no desktop: linhas de 3 fotos (grid de 6 colunas, cada
     foto ocupa 2). Se a última linha sobrar incompleta, as fotos dela esticam
     p/ fechar sem buraco, mantendo a altura das demais (4:3 com 1/3 da
     largura = 2:1 com 1/2 = 3:1 com a largura toda) */
  @media (min-width: 769px) {
    .ambientes-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .ambientes-item {
      grid-column: span 2;
    }

    /* sobram 2: meia largura cada */
    .ambientes-item:nth-child(3n + 1):nth-last-child(2),
    .ambientes-item:nth-child(3n + 1):nth-last-child(2) + .ambientes-item {
      grid-column: span 3;
      aspect-ratio: 2 / 1;
    }

    /* sobra 1: linha inteira */
    .ambientes-item:nth-child(3n + 1):last-child {
      grid-column: 1 / -1;
      aspect-ratio: 3 / 1;
    }
  }

  /* Gastronomia no mobile: foto grande + faixa de miniaturas (em vez de outro
     carrossel igual ao de "Espaço completo"). Miniaturas só existem no mobile */
  .gastro-v3-thumbs {
    display: none;
  }

  @media (max-width: 768px) {
    .gastro-v3-track {
      display: block;
      margin: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .gastro-v3-item {
      display: none;
      aspect-ratio: 5 / 4;
    }

    .gastro-v3-item.is-active {
      display: block;
    }

    /* setas por dentro da foto grande */
    .gastro-v3-btn--prev {
      left: 8px;
    }

    .gastro-v3-btn--next {
      right: 8px;
    }

    .gastro-v3-thumbs {
      display: flex;
      gap: 6px;
      margin-top: 10px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .gastro-v3-thumbs::-webkit-scrollbar {
      display: none;
    }

    .gastro-v3-thumbs :global(.gallery-thumb) {
      flex: 0 0 60px;
      height: 60px;
      padding: 0;
      border: 2px solid transparent;
      border-radius: 6px;
      overflow: hidden;
      background: none;
      opacity: .55;
      cursor: pointer;
      transition: opacity .2s, border-color .2s;
    }

    .gastro-v3-thumbs :global(.gallery-thumb.is-active) {
