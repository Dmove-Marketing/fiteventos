<script>
  function setupInfiniteSlider(containerId: string) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const slider = container.querySelector<HTMLElement>('.carousel-slider');
    const prevBtn = container.querySelector<HTMLElement>('.carousel-nav-prev');
    const nextBtn = container.querySelector<HTMLElement>('.carousel-nav-next');
    if (!slider) return;

    const origSlides = Array.from(slider.querySelectorAll<HTMLElement>('.carousel-slide-item'));
    const total = origSlides.length;
    if (total < 2) return;

    // Clone first and last slide for seamless infinite loop
    const firstClone = origSlides[0].cloneNode(true) as HTMLElement;
    const lastClone = origSlides[total - 1].cloneNode(true) as HTMLElement;
    firstClone.classList.add('clone');
    lastClone.classList.add('clone');

    slider.appendChild(firstClone);
    slider.insertBefore(lastClone, origSlides[0]);

    // Index 1 corresponds to original slide 1
    let currentIndex = 1;
    let isTransitioning = false;

    // Set initial position without animation
    slider.style.transition = 'none';
    slider.style.transform = `translateX(-${currentIndex * 100}%)`;
    slider.offsetHeight; // force reflow

    function moveTo(index: number, animate = true) {
      if (!slider) return;
      if (animate) {
        slider.style.transition = 'transform 0.5s ease-in-out';
      } else {
        slider.style.transition = 'none';
      }
      slider.style.transform = `translateX(-${index * 100}%)`;
      currentIndex = index;
    }

    slider.addEventListener('transitionend', () => {
      isTransitioning = false;
      // If at last clone (after slide N), snap to real slide 1
      if (currentIndex === total + 1) {
        moveTo(1, false);
      }
      // If at first clone (before slide 1), snap to real slide N
      if (currentIndex === 0) {
        moveTo(total, false);
      }
    });

    function next() {
      if (isTransitioning) return;
      isTransitioning = true;
      moveTo(currentIndex + 1, true);
    }

    function prev() {
      if (isTransitioning) return;
      isTransitioning = true;
      moveTo(currentIndex - 1, true);
    }

    prevBtn?.addEventListener('click', () => {
      prev();
      resetTimer();
    });

    nextBtn?.addEventListener('click', () => {
      next();
      resetTimer();
    });

    let autoTimer = setInterval(next, 4500);

    function resetTimer() {
      clearInterval(autoTimer);
      autoTimer = setInterval(next, 4500);
    }

    container.addEventListener('mouseenter', () => clearInterval(autoTimer));
    container.addEventListener('mouseleave', resetTimer);
  }

  function setupHeroSlider() {
    const slides = document.querySelectorAll<HTMLElement>('#hero .hero-slide');
    if (slides.length < 2) return;
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('active');
    }, 5000);
  }

  function initNav() {
    const _header = document.getElementById('header');
    const _hb = document.getElementById('hamburger');
    const _menu = document.getElementById('mobile-menu');
    const _close = document.getElementById('mobile-close');

    // Header scroll background toggle
    window.addEventListener('scroll', () => {
      _header?.classList.toggle('scrolled', window.scrollY > 60);
    });

    // Mobile nav toggle & link auto-close
    function openMenu() {
      _menu?.classList.add('open');
      _hb?.classList.add('active');
    }
    function closeMenu() {
      _menu?.classList.remove('open');
      _hb?.classList.remove('active');
    }

    if (_hb) _hb.addEventListener('click', openMenu);
    if (_close) _close.addEventListener('click', closeMenu);
    _menu?.querySelectorAll('a').forEach(l => l.addEventListener('click', closeMenu));
  }

  function setupLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const closeBtn = document.getElementById('lightbox-close');
    if (!lightbox || !lightboxImg || !closeBtn) return;

    document.querySelectorAll('.galeria-item img').forEach((img) => {
      img.parentElement?.addEventListener('click', () => {
        if (lightboxImg instanceof HTMLImageElement) {
          lightboxImg.src = img.getAttribute('src') || '';
          lightboxImg.alt = img.getAttribute('alt') || '';
        }
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeLightbox() {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    }

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  }

  function init() {
    setupHeroSlider();
    setupInfiniteSlider('gastronomia-carousel');
    setupInfiniteSlider('espacos-carousel');
    initNav();
    setupLightbox();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
