---
import Base from "../layouts/Base.astro";
import config from "../../config.json";
import Img from "../components/ui/Img.astro";
import LeadForm from "../components/forms/LeadForm.astro";
import "../styles/casamentos.css";
---

<Base
  title="Casamentos com Estilo e Sofisticação – Espaço Fit Eventos"
  description="Realize o seu casamento no Espaço Fit Eventos. Arquitetura contemporânea, gastronomia exclusiva assinada pelo Chef Dalton Rangel e ambientes versáteis em São Paulo."
  ogImage="/images/novo_logo.png"
>
  <!-- HEADER -->
  <header id="header">
    <div class="container">
      <div class="header-inner">
        <a href="#hero" class="logo">
          <Img
            src="logo.fiteventos.webp"
            alt="Espaço Fit Eventos"
            class="logo-img"
            priority
          />
        </a>
        <nav id="nav">
          <a href="#autoridade">Sobre</a>
          <a href="#espacos">Espaços</a>
          <a href="#servicos">Serviços</a>
          <a href="#gastronomia">Gastronomia</a>
          <a href="#diferenciais">Diferenciais</a>
          <a href="#galeria">Galeria</a>
          <a href="#contato" class="nav-cta">Orçamento</a>
        </nav>
        <div class="hamburger" id="hamburger">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </header>

  <!-- MOBILE MENU OVERLAY -->
  <div id="mobile-menu">
    <button id="mobile-close" aria-label="Fechar menu">✕</button>
    <a href="#autoridade">Sobre</a>
    <a href="#espacos">Espaços</a>
    <a href="#servicos">Serviços</a>
    <a href="#gastronomia">Gastronomia</a>
    <a href="#diferenciais">Diferenciais</a>
    <a href="#galeria">Galeria</a>
    <a href="#contato" class="nav-cta">Orçamento</a>
  </div>

  <!-- HERO -->
  <section id="hero">
    <div class="hero-slides">
      <div class="hero-slide active">
        <img
          src="https://media.dmove.com.br/clients/espacofitcom/photos/hero04_casamentos_v2.webp"
          alt="Casamentos Espaço Fit Eventos"
          class="hero-slide-img"
        />
      </div>
      <div class="hero-slide">
        <img
          src="https://media.dmove.com.br/clients/espacofitcom/photos/hero03_casamentos_v2.webp"
          alt="Casamentos Espaço Fit Eventos"
          class="hero-slide-img"
        />
      </div>
      <div class="hero-slide">
        <img
          src="https://media.dmove.com.br/clients/espacofitcom/photos/hero01_casamentos_v2.webp"
          alt="Casamentos Espaço Fit Eventos"
          class="hero-slide-img"
        />
      </div>
      <div class="hero-slide">
        <img
          src="https://media.dmove.com.br/clients/espacofitcom/photos/hero02_casamentos_v2.webp"
          alt="Casamentos Espaço Fit Eventos"
          class="hero-slide-img"
        />
      </div>
    </div>
    <div class="hero-gradient"></div>
    <div class="hero-accent"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-eyebrow">
          <span>São Paulo · Casamentos</span>
        </div>
        <h1>
          Um dia marcante <br />se transformando em <br /><em>um momento único</em>
        </h1>
        <div class="hero-actions">
          <a href="#contato" class="btn btn-primary">
            Solicite orçamento
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÇÃO AUTORIDADE / SOBRE -->
  <section id="autoridade">
    <div class="container">
      <div class="ev-grid">
        <div class="ev-text">
          <span class="label">Sobre o Espaço Fit</span>
          <h2>Detalhes pensados <br />para celebrar a <br /><em>sua história</em></h2>
          <p>
            Seu grande dia merece a perfeição em cada detalhe. Vivencie a experiência de um casamento impecável, acolhido por um cenário encantador com alta gastronomia personalizada e ambientação sob medida para marcar a sua história.
          </p>
          <div class="autoridade-actions">
            <a href="#contato" class="btn btn-primary">
              Falar com um especialista
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
        <div class="ev-media">
          <div class="ev-image-wrapper">
            <img
              src="https://media.dmove.com.br/clients/espacofitcom/photos/sobre-casamentos_resultado.webp"
              alt="Detalhes para celebrar sua história de casamento"
              class="autoridade-img"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÇÃO ESPAÇOS (EDITORIAL GRID GALLERY SEM LIGHTBOX) -->
  <section id="espacos">
    <div class="container">
      <div class="section-header">
        <span class="label">Nossos Espaços</span>
        <h2>Arte de celebrar <br /><em>e encantar</em></h2>
        <p class="section-desc">
          Cada casamento possui uma identidade própria. Por isso, nossos espaços oferecem liberdade para criar cerimônias e recepções totalmente personalizadas, integrando ambientes que acompanham cada momento da celebração.
        </p>
      </div>

      <div class="carousel-container" id="espacos-carousel">
        <button class="carousel-nav-btn carousel-nav-prev" aria-label="Anterior">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <div class="carousel-slider espacos-grid-gallery">
          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos06_resultado.webp" alt="Espaço Casamentos 06" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos05_resultado.webp" alt="Espaço Casamentos 05" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos04_resultado.webp" alt="Espaço Casamentos 04" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos03_resultado.webp" alt="Espaço Casamentos 03" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos02_resultado.webp" alt="Espaço Casamentos 02" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos01_resultado.webp" alt="Espaço Casamentos 01" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos09.webp" alt="Espaço Casamentos 09" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos08.webp" alt="Espaço Casamentos 08" loading="lazy" />
          </div>

          <div class="carousel-slide-item espaco-card-item">
            <img src="https://media.dmove.com.br/clients/espacofitcom/photos/espaco_casamentos07.webp" alt="Espaço Casamentos 07" loading="lazy" />
          </div>
        </div>
        <button class="carousel-nav-btn carousel-nav-next" aria-label="Próximo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- SEÇÃO SERVIÇOS -->
  <section id="servicos">
    <div class="container">
      <div class="section-header">
        <span class="label">Experiência Completa</span>
        <h2>Uma celebração <br class="br-mobile" />construída <br class="br-desktop" /><em class="em-rose-desktop">nos</em> <br class="br-mobile" /><em>detalhes</em></h2>
      </div>

      <div class="servicos-grid">
        <!-- Bar Fit -->
        <div class="servico-card">
          <div class="servico-img-box">
            <img
              src="https://media.dmove.com.br/clients/espacofitcom/photos/bar-fit_casamnetos_resultado.webp"
              alt="Bar Fit"
            />
          </div>
          <div class="servico-content">
            <h3>Bar Fit</h3>
            <p>Drinks autorais, clássicos e layouts personalizáveis para acompanhar o estilo de cada casamento. Do moderno ao clássico, o Bar Fit cria experiências únicas para cada celebração.</p>
          </div>
        </div>

        <!-- Alta Confeitaria -->
        <div class="servico-card">
          <div class="servico-img-box">
            <img
              src="https://media.dmove.com.br/clients/espacofitcom/photos/alta-confeitaria_casamentos_resultado.webp"
              alt="Confeitaria"
            />
          </div>
          <div class="servico-content">
            <h3>Confeitaria</h3>
            <p>Criações exclusivas de alta confeitaria, desenvolvidas para encantar pelos sabores refinados e pela estética cuidadosamente elaborada.</p>
          </div>
        </div>

        <!-- Decoração -->
        <div class="servico-card">
          <div class="servico-img-box">
            <img
              src="https://media.dmove.com.br/clients/espacofitcom/photos/decoraca-_casamentos-v2.webp"
              alt="Decoração"
            />
          </div>
          <div class="servico-content">
            <h3>Decoração</h3>
            <p>Sua história merece um cenário à altura, com decoração personalizada, elementos exclusivos, paleta harmoniosa, texturas e mobiliário que traduzem seu estilo em uma celebração sofisticada e autêntica.</p>
          </div>
        </div>

        <!-- Entretenimento -->
        <div class="servico-card">
          <div class="servico-img-box">
            <img
              src="https://media.dmove.com.br/clients/espacofitcom/photos/entretenimento_resultado.webp"
              alt="Entretenimento"
            />
          </div>
          <div class="servico-content">
            <h3>Entretenimento</h3>
            <p>Atrações para envolver os convidados e tornar a festa ainda mais dinâmica e memorável.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÇÃO GASTRONOMIA (CARROSSEL INFINITO) -->
  <section id="gastronomia">
    <div class="container">
      <div class="ev-grid ev-grid-reverse">
        <div class="ev-text">
          <span class="label">Gastronomia Exclusiva</span>
          <h2>Sabores que também <br /><em>contam histórias</em></h2>
          <p>
            Assinada pelo premiado Chef Dalton Rangel, a gastronomia do Espaço Fit Eventos transforma cada momento da recepção em uma experiência memorável.
          </p>
          <p>
            Os cardápios são desenvolvidos de forma personalizada para refletir o estilo da celebração, combinando ingredientes selecionados, apresentações sofisticadas e opções para diferentes preferências e restrições alimentares.
          </p>
          <p>
            Antes do casamento, os noivos vivem uma experiência exclusiva na sala de degustação, onde acompanham de perto a construção do menu que fará parte desse momento especial.
          </p>

          <div class="gastronomia-highlights">
            <div class="gastronomia-item">
              <span>Menu assinado pelo Chef Dalton Rangel</span>
            </div>
            <div class="gastronomia-item">
              <span>Experiência prévia na Sala de Degustação</span>
            </div>
            <div class="gastronomia-item">
              <span>Opções para diferentes preferências e restrições</span>
            </div>
          </div>
        </div>
        <div class="ev-media">
          <div class="carousel-container" id="gastronomia-carousel">
            <button class="carousel-nav-btn carousel-nav-prev" aria-label="Anterior">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <div class="carousel-slider">
              <div class="carousel-slide-item">
                <img src="https://media.dmove.com.br/clients/espacofitcom/photos/gastronomia_casamentos05_resultado.webp" alt="Gastronomia Casamentos 05" />
              </div>
              <div class="carousel-slide-item">
                <img src="https://media.dmove.com.br/clients/espacofitcom/photos/gastronomia_casamentos04_resultado.webp" alt="Gastronomia Casamentos 04" />
              </div>
              <div class="carousel-slide-item">
                <img src="https://media.dmove.com.br/clients/espacofitcom/photos/gastronomia_casamentos03_resultado.webp" alt="Gastronomia Casamentos 03" />
              </div>
              <div class="carousel-slide-item">
                <img src="https://media.dmove.com.br/clients/espacofitcom/photos/gastronomia_casamentos02_resultado.webp" alt="Gastronomia Casamentos 02" />
              </div>
              <div class="carousel-slide-item">
                <img src="https://media.dmove.com.br/clients/espacofitcom/photos/gastronomia_casamentos01_resultado.webp" alt="Gastronomia Casamentos 01" />
              </div>
            </div>
            <button class="carousel-nav-btn carousel-nav-next" aria-label="Próximo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÇÃO DIFERENCIAIS -->
  <section id="diferenciais">
    <div class="container">
      <div class="section-header">
        <span class="label">Diferenciais</span>
        <h2>Estrutura que valoriza <br /><em>cada momento</em></h2>
      </div>

      <div class="diferenciais-grid">
        <!-- 1. Climatizado (Snowflake) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20M20 16l-4-4 4-4M4 8l4 4-4 4M16 4l-4 4-4-4M8 20l4-4 4 4"/></svg>
          </div>
          <h3>Espaço climatizado</h3>
          <p>Ambientes totalmente climatizados para máximo conforto térmico em todas as estações do ano.</p>
        </div>

        <!-- 2. Jardim Vertical (Leaf) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A9 9 0 0 1 2 11 9 9 0 0 1 11 2c6 0 11 5 11 11a9 9 0 0 1-11 7z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
          </div>
          <h3>Jardim vertical exclusivo</h3>
          <p>Paisagismo contemporâneo integrado aos ambientes, perfeito para cenários de fotos memoráveis.</p>
        </div>

        <!-- 3. Arquitetura (Building/Structure) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M8 10h.01M16 10h.01M8 14h.01M16 14h.01"/></svg>
          </div>
          <h3>Arquitetura contemporânea</h3>
          <p>Design moderno com linhas arrojadas, iluminação cênica e layouts totalmente adaptáveis.</p>
        </div>

        <!-- 4. Personalização (Palette) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.92 0 1.7-.72 1.7-1.65 0-.43-.17-.83-.44-1.14-.29-.33-.46-.77-.46-1.26 0-1.04.84-1.89 1.88-1.89h1.76c3.1 0 5.56-2.47 5.56-5.57 0-4.69-4.26-8.49-10-8.49z"/></svg>
          </div>
          <h3>Personalização completa</h3>
          <p>Flexibilidade total para adaptar ambientação, serviços e cenografia de acordo com o perfil dos noivos.</p>
        </div>

        <!-- 5. Convidados (Users) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Até 530 convidados</h3>
          <p>Capacidade versátil para receber desde mini weddings aconchegantes até grandes recepções.</p>
        </div>

        <!-- 6. Projeção Mapeada (Sparkles/Light) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3z"/><path d="M5 3v4M3 5h4M19 17v4M17 19h4"/></svg>
          </div>
          <h3>Projeção mapeada</h3>
          <p>Recursos audiovisuais de ponta para criar efeitos visuais imersivos e inesquecíveis.</p>
        </div>

        <!-- 7. Atendimento (Heart) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h3>Atendimento elogiado</h3>
          <p>Equipe altamente qualificada e atenciosa dedicada ao suporte total em cada fase da celebração.</p>
        </div>

        <!-- 8. Custo-benefício (Diamond) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M11 3 8 9l3 12"/><path d="M13 3l3 6-3 12"/><path d="M2 9h20"/></svg>
          </div>
          <h3>Excelente custo-benefício</h3>
          <p>Soluções integradas com transparência de custos e alto padrão em todos os serviços fornecidos.</p>
        </div>

        <!-- 9. Localização (Map Pin) -->
        <div class="diferencial-card">
          <div class="diferencial-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Localização privilegiada</h3>
          <p>Fácil acesso na Zona Sul de São Paulo, próximo à Marginal Pinheiros, transporte e hotéis.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÇÃO DEPOIMENTOS -->
  <section id="depoimentos">
    <div class="container">
      <div class="dep-header">
        <span class="label">Depoimentos</span>
        <h2>Momentos especiais e depoimentos <br />contados por quem já celebrou <br /><em>no Espaço Fit Eventos</em></h2>
      </div>
      
      <div class="dep-grid">
        <div class="dep-card-inner">
          <div class="dep-stars">★★★★★</div>
          <blockquote>"O lugar é super aconchegante e o espaço foi perfeito para acomodar nossos convidados. A equipe é atenciosa e tornou o dia inesquecível. Super recomendo!"</blockquote>
          <cite>— Fernanda & Gustavo</cite>
        </div>
        <div class="dep-card-inner">
          <div class="dep-stars">★★★★★</div>
          <blockquote>"Lugar incrível! Amplo, moderno e muito acolhedor. Gastronomia impecável e atendimento de primeiríssima qualidade. Amei a experiência no Espaço Fit."</blockquote>
          <cite>— Nestor & Camila</cite>
        </div>
        <div class="dep-card-inner">
          <div class="dep-stars">★★★★★</div>
          <blockquote>"Espaço muito bonito e elegante para casamentos, estrutura ótima. Ambientes integrados, comida sensacional e funcionários extremamente educados."</blockquote>
          <cite>— Evelin & Rodrigo</cite>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÇÃO GALERIA -->
  <section id="galeria">
    <div class="container">
      <div class="section-header">
        <span class="label">Galeria de Fotos</span>
        <h2>Inspire-se para <br class="br-mobile" />realizar o <br class="br-desktop" /><em class="em-rose-desktop">casamento</em> <br class="br-mobile" /><em>dos seus sonhos</em></h2>
      </div>

      <div class="galeria-grid">
        <div class="galeria-item span-2x2">
          <img src="https://media.dmove.com.br/clients/espacofitcom/photos/galeria_casamentos12_resultado.webp" alt="Galeria Casamentos 12" loading="lazy" />
        </div>
        <div class="galeria-item">
