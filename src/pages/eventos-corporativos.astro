---
// Gerado a partir de: eventos-corporativos.html
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import '../styles/eventos-corporativos.css';
---

<Base
  title="Eventos Corporativos – Espaço Fit Eventos"
  description="Salas versáteis, tecnologia integrada e uma operação preparada para receber desde encontros estratégicos até grandes convenções corporativas."
  ogImage="/images/novo_logo.png"
>
<!-- HEADER -->
<header id="header">
  <div class="container">
    <a href="/" class="logo">
      <Img src="logo.fiteventos.webp" alt="Espaço Fit Eventos" priority />
    </a>
    <nav id="nav">
      <a href="#espacos">Ambientes</a>
      <a href="#estrutura">Estrutura</a>
      <a href="#gastronomia">Gastronomia</a>
      <a href="#galeria">Galeria</a>
      <a href="#contato">Contato</a>
      <a href="#contato" class="nav-cta">Solicitar Orçamento</a>
    </nav>
    <div class="hamburger" id="hamburgerBtn" aria-label="Abrir menu">
      <span></span><span></span><span></span>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  <button class="mobile-close" id="mobileClose" aria-label="Fechar menu">✕</button>
  <a href="#espacos">Ambientes</a>
  <a href="#estrutura">Estrutura</a>
  <a href="#gastronomia">Gastronomia</a>
  <a href="#galeria">Galeria</a>
  <a href="#contato">Contato</a>
  <a href="#contato" class="mobile-cta">Solicitar Orçamento</a>
</div>

<!-- HERO -->
<section id="hero">
  <div id="hero-slides">
    <div class="hero-slide active"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero-corporativo09.webp" alt="Eventos Corporativos" fetchpriority="high" /></div>
    <div class="hero-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero-corporativo08.webp" alt="Eventos Corporativos" loading="lazy" /></div>
    <div class="hero-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero-corporativo07.webp" alt="Eventos Corporativos" loading="lazy" /></div>
    <div class="hero-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero-corporativo06.webp" alt="Eventos Corporativos" loading="lazy" /></div>
    <div class="hero-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero-corporativo05.webp" alt="Eventos Corporativos" loading="lazy" /></div>
    <div class="hero-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero-corporativo04.webp" alt="Eventos Corporativos" loading="lazy" /></div>
    <div class="hero-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero-corporativo03.webp" alt="Eventos Corporativos" loading="lazy" /></div>
    <div class="hero-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/hero_corporativo-nova.webp" alt="Eventos Corporativos" loading="lazy" /></div>
  </div>
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-tag">São Paulo · Eventos Corporativos</div>
      <h1>O espaço ideal para eventos corporativos que exigem impacto, <em>flexibilidade e excelência</em></h1>
      <p>Salas versáteis, tecnologia integrada e uma operação preparada para receber desde encontros estratégicos até grandes convenções corporativas.</p>
      <div class="hero-actions">
        <a href="#contato" class="btn btn-primary">Solicite orçamento</a>
      </div>
    </div>
  </div>
</section>

<!-- AUTORIDADE -->
<section id="autoridade">
  <div class="container">
    <div class="autoridade-grid">
      <div class="autoridade-visual">
        <div class="autoridade-video-wrap">
          <video autoplay muted loop playsinline>
            <source src="https://media.dmove.com.br/clients/espacofitcom/videos/video_sobre-fiteventos.webm" type="video/webm" />
          </video>
        </div>
      </div>
      <div class="autoridade-content">
        <span class="label">Sobre o espaço</span>
        <h2>Uma estrutura que<br class="br-mob"> se adapta<br class="br-d"> <em><span class="mob-black">ao formato</span><br class="br-mob"> do seu evento</em></h2>
        <p>Desde 2012, o Espaço Fit Eventos atende empresas de médio e grande porte que buscam estrutura, organização e excelência na execução de seus eventos.</p>
        <p>Com uma operação ativa e ambientes preparados para alta demanda, o espaço se consolidou como uma escolha confiável para treinamentos, convenções e eventos empresariais de grande porte.</p>
      </div>
    </div>
  </div>
</section>

<!-- ESPAÇOS -->
<section id="espacos">
  <div class="section-header container">
    <span class="label">Nossos ambientes</span>
    <h2>Flexibilidade para<br class="br-mob"> criar o<br class="br-d"> <em style="color:var(--rose)"><span class="mob-black">evento do</span><br class="br-mob"> seu jeito</em></h2>
    <p>Espaços versáteis, funcionais e prontos para diferentes dinâmicas corporativas, de reuniões estratégicas a grandes apresentações.</p>
  </div>
  <div class="espacos-grid">
    <div class="espaco-card wide">
      <div class="card-slides">
        <div class="card-slide active"><Img src="salas_treinamento.eventos-corporativos01.webp" alt="Salas de Treinamento e Auditórios" /></div>
        <div class="card-slide"><Img src="salas_treinamento.eventos-corporativos02.webp" alt="Salas de Treinamento e Auditórios" /></div>
        <div class="card-slide"><Img src="salas_treinamento.eventos-corporativos03.webp" alt="Salas de Treinamento e Auditórios" /></div>
        <div class="card-slide"><Img src="salas_treinamento.eventos-corporativos04.webp" alt="Salas de Treinamento e Auditórios" /></div>
        <div class="card-slide"><Img src="salas_treinamento.eventos-corporativos05.webp" alt="Salas de Treinamento e Auditórios" /></div>
      </div>
      <div class="espaco-overlay">
        <div class="espaco-info">
          <h3>Salas de Treinamento e Auditórios</h3>
          <p>Layouts flexíveis, auditório, U, escolar, mesas redondas, com capacidade para 10 a 530 convidados</p>
        </div>
      </div>
    </div>
    <div class="espaco-card">
      <div class="card-slides">
        <div class="card-slide active"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/sala_desing-corporativo06.webp" alt="Salas Design Thinking" loading="lazy" /></div>
        <div class="card-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/sala_desing-corporativo05.webp" alt="Salas Design Thinking" loading="lazy" /></div>
        <div class="card-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/sala_desing-corporativo04.webp" alt="Salas Design Thinking" loading="lazy" /></div>
        <div class="card-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/sala_desing-corporativo03.webp" alt="Salas Design Thinking" loading="lazy" /></div>
        <div class="card-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/sala_desing-corporativo02.webp" alt="Salas Design Thinking" loading="lazy" /></div>
        <div class="card-slide"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/sala_desing-corporativo01.webp" alt="Salas Design Thinking" loading="lazy" /></div>
      </div>
      <div class="espaco-overlay">
        <div class="espaco-info">
          <h3>Salas Design Thinking</h3>
          <p>Espaços que estimulam troca, criatividade e construção coletiva</p>
        </div>
      </div>
    </div>
    <div class="espaco-card">
      <div class="card-slides">
        <div class="card-slide active"><Img src="salas_vip.eventos-corporativos01.webp" alt="Sala VIP" /></div>
        <div class="card-slide"><Img src="salas_vip.eventos-corporativos02.webp" alt="Sala VIP" /></div>
        <div class="card-slide"><Img src="salas_vip.eventos-corporativos03.webp" alt="Sala VIP" /></div>
      </div>
      <div class="espaco-overlay">
        <div class="espaco-info">
          <h3>Sala VIP</h3>
          <p>Ambiente exclusivo para receber convidados com conforto e privacidade</p>
        </div>
      </div>
    </div>
    <div class="espaco-card">
      <div class="card-slides">
        <div class="card-slide active"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/estrutura_sala-reuniao.webp" alt="Sala de Reunião" loading="lazy" /></div>
      </div>
      <div class="espaco-overlay">
        <div class="espaco-info">
          <h3>Sala de Reunião</h3>
          <p>Ideal para reuniões executivas, alinhamentos e apresentações estratégicas</p>
        </div>
      </div>
    </div>
    <div class="espaco-card">
      <div class="card-slides">
        <div class="card-slide active"><Img src="camarim.eventos-corporativos01.webp" alt="Camarim" /></div>
        <div class="card-slide"><Img src="camarim.eventos-corporativos02.webp" alt="Camarim" /></div>
        <div class="card-slide"><Img src="camarim.eventos-corporativos03.webp" alt="Camarim" /></div>
      </div>
      <div class="espaco-overlay">
        <div class="espaco-info">
          <h3>Camarim</h3>
          <p>Estrutura de apoio para palestrantes, produções e convidados especiais</p>
        </div>
      </div>
    </div>
  </div>
  <div class="espaco-cta container">
    <a href="#contato" class="btn btn-gold">Descubra o espaço ideal para o seu evento</a>
  </div>
</section>

<!-- ESTRUTURA + TECNOLOGIA -->
<section id="estrutura">
  <div class="estrutura-lead container">
    <span class="label" style="color:var(--rose)">Infraestrutura</span>
    <h2>Soluções integradas<br class="br-mob"> para <em><span class="mob-black">eventos presenciais</span><br class="br-mob"> e híbridos</em></h2>
    <p>Do audiovisual à circulação entre ambientes, cada detalhe é planejado para garantir fluidez, conforto e eficiência durante todo o evento.</p>
  </div>
  <div class="estrutura-grid">
    <div class="estrutura-item">
      <img src="https://media.dmove.com.br/clients/espacofitcom/photos/paineis-corporativo_v2.webp" alt="Painéis de LED e projeção mapeada" loading="lazy" />
      <div class="estrutura-caption">Painéis de LED e projeção mapeada</div>
    </div>
    <div class="estrutura-item">
      <img src="https://media.dmove.com.br/clients/espacofitcom/photos/transmissao-corporativo.webp" alt="Transmissão ao vivo e streaming" loading="lazy" />
      <div class="estrutura-caption">Transmissão ao vivo e streaming</div>
    </div>
  </div>
</section>

<!-- GASTRONOMIA -->
<section id="gastronomia">
  <div class="gastro-grid container">
      <div class="gastro-text">
        <span class="label">Gastronomia</span>
        <h2>Menus planejados com cuidado<br><em style="color:var(--rose)">para cada momento</em></h2>
        <p>Do coffee break ao jantar corporativo, o Espaço Fit oferece uma experiência gastronômica versátil e personalizada, assinada pelo premiado <b>Chef Dalton Rangel</b>.</p>
        <p>Menus adaptados ao perfil do evento e dos convidados, incluindo <b>alternativas veganas e vegetarianas</b>.</p>
        <div class="gastro-tags">
          <span class="gastro-tag">Coffee break</span>
          <span class="gastro-tag">Almoço corporativo</span>
          <span class="gastro-tag">Finger foods</span>
          <span class="gastro-tag">Jantar completo</span>
          <span class="gastro-tag">Menu vegano</span>
          <span class="gastro-tag">Menu vegetariano</span>
        </div>
      </div>
      <div class="gastro-image">
        <div class="gastro-slides">
          <div class="gastro-slide active"><img src="https://media.dmove.com.br/clients/espacofitcom/photos/gastronomia-corporativo.webp" alt="Gastronomia Espaço Fit Eventos" loading="lazy" /></div>
        </div>
        <div class="gastro-badge">
          Assinado por<strong>Chef Dalton Rangel</strong>
        </div>
      </div>
  </div>
</section>

<!-- PARCEIROS -->
<section id="parceiros">
  <div class="parceiros-head reveal">
    <span class="label">Parceiros</span>
    <h2>Onde grandes marcas realizam <br/><em style="font-style:normal; font-weight:700; color:var(--rose)">experiências memoráveis</em></h2>
