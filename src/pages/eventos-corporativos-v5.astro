  /* "Espaço completo" no desktop: linhas de 3 fotos (grid de 6 colunas, cada
     foto ocupa 2). Se a última linha sobrar incompleta, as fotos dela esticam
     p/ fechar sem buraco, mantendo a altura das demais (4:3 com 1/3 da
     largura = 2:1 com 1/2 = 3:1 com a largura toda) */
  @media (min-width: 769px) {
    .ambientes-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .ambientes-item {
      grid-column: span 2;
    }

    /* sobram 2: meia largura cada */
    .ambientes-item:nth-child(3n + 1):nth-last-child(2),
    .ambientes-item:nth-child(3n + 1):nth-last-child(2) + .ambientes-item {
      grid-column: span 3;
      aspect-ratio: 2 / 1;
    }

    /* sobra 1: linha inteira */
    .ambientes-item:nth-child(3n + 1):last-child {
      grid-column: 1 / -1;
      aspect-ratio: 3 / 1;
    }
  }

