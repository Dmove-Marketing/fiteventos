<script>
  import '../scripts/eventos-corporativos-v5.js';
  import { initForms } from '../scripts/forms';

  const byId = (id: string) => document.getElementById(id);

  // ── Carrosséis (v3): cada clique nas setas rola uma foto (item + gap)
  function setupCarousel(track: HTMLElement | null, prev: HTMLElement | null, next: HTMLElement | null) {
    if (!track) return;
    const step = () => {
      const item = track.firstElementChild as HTMLElement | null;
      return (item?.offsetWidth ?? 0) + (parseFloat(getComputedStyle(track).columnGap) || 0);
    };
    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  }
  setupCarousel(byId('gastroTrack'), byId('gastroPrev'), byId('gastroNext'));


  // ── Galeria "foto grande + miniaturas" (Gastronomia no mobile): tocar na
  // miniatura, nas setas ou deslizar na foto grande troca a foto. No desktop o
  // CSS ignora o estado "ativo" e a mesma trilha segue como carrossel
  function setupThumbGallery(track: HTMLElement | null, thumbsEl: HTMLElement | null, prev: HTMLElement | null, next: HTMLElement | null) {
    if (!track || !thumbsEl) return;
    const items = [...track.children] as HTMLElement[];
    if (!items.length) return;
    let current = 0;

    const thumbs = items.map((item, i) => {
      const img = item.querySelector('img');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'gallery-thumb';
      btn.setAttribute('aria-label', `Ver foto ${i + 1}: ${img?.alt ?? ''}`);
      if (img) {
        const t = document.createElement('img');
        t.src = img.getAttribute('src') ?? '';
        t.alt = '';
        t.loading = 'lazy';
        btn.appendChild(t);
      }
      btn.addEventListener('click', () => select(i));
      thumbsEl.appendChild(btn);
      return btn;
    });

    function select(i: number) {
      current = (i + items.length) % items.length;
      items.forEach((el, k) => el.classList.toggle('is-active', k === current));
      thumbs.forEach((t, k) => {
        t.classList.toggle('is-active', k === current);
        t.setAttribute('aria-current', k === current ? 'true' : 'false');
      });
      // centraliza a miniatura ativa na faixa (sem rolar a página)
      const t = thumbs[current];
      thumbsEl!.scrollTo({ left: t.offsetLeft - (thumbsEl!.clientWidth - t.offsetWidth) / 2, behavior: 'smooth' });
    }
    select(0);

    prev?.addEventListener('click', () => select(current - 1));
    next?.addEventListener('click', () => select(current + 1));

    let startX = 0;
    track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) select(current + (dx < 0 ? 1 : -1));
    });
  }
  setupThumbGallery(byId('gastroTrack'), byId('gastroThumbs'), byId('gastroPrev'), byId('gastroNext'));

  // ── Carrosséis "Salas e formatos": faixa com rolagem nativa (arrastar/dedo),
  // setas avançam 1 foto, contador "03 / 14" e barra de progresso acompanham
  function setupSalasCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('.salas-v5-track');
    if (!track) return;
    const slides = [...track.children] as HTMLElement[];
    const n = slides.length;
    if (!n) return;
    slides.forEach((el, i) => { el.dataset.i = String(i); });
    const count = root.querySelector<HTMLElement>('.salas-v5-count');
    const bar = root.querySelector<HTMLElement>('.salas-v5-progress i');
    // setas do topo (desktop) e setas sobre as fotos (celular)
    const prevs = root.querySelectorAll<HTMLButtonElement>('.salas-v5-arrow--prev');
    const nexts = root.querySelectorAll<HTMLButtonElement>('.salas-v5-arrow--next');
    const pad = (v: number) => String(v).padStart(2, '0');
    const step = () => slides[0].offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0);

    const paint = () => {
      const max = track.scrollWidth - track.clientWidth;
      const atEnd = track.scrollLeft >= max - 2;
      // no fim da faixa conta a última foto (as últimas cabem juntas na tela)
      const i = atEnd ? n - 1 : Math.min(n - 1, Math.round(track.scrollLeft / step()));
      if (count) count.textContent = `${pad(i + 1)} / ${pad(n)}`;
      if (bar) bar.style.width = `${((i + 1) / n) * 100}%`;
      prevs.forEach((b) => { b.disabled = track.scrollLeft <= 2; });
      nexts.forEach((b) => { b.disabled = atEnd; });
    };
    track.addEventListener('scroll', paint, { passive: true });
    prevs.forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' })));
    nexts.forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' })));

    // Arrastar com o mouse (no toque o scroll nativo já resolve)
    let down = false, startX = 0, startLeft = 0, moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
      track.classList.add('is-dragging');
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!down) return;
      down = false;
      track.classList.remove('is-dragging');
      const s = step();
      track.scrollTo({ left: Math.round(track.scrollLeft / s) * s, behavior: 'smooth' });
    });
    // arrasto não conta como clique (não abre o visualizador)
    track.addEventListener('click', (e) => { if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; } }, true);

    paint();
    window.addEventListener('resize', paint);
  }
  document.querySelectorAll<HTMLElement>('.salas-v5-block').forEach(setupSalasCarousel);

  // ── Localização (celular): cartões em carrossel; setas e barra de progresso
  (() => {
    const track = document.querySelector<HTMLElement>('.loc-v5-cards');
    if (!track) return;
    const cards = [...track.children] as HTMLElement[];
    const prev = document.querySelector<HTMLButtonElement>('.loc-v5-arrow--prev');
    const next = document.querySelector<HTMLButtonElement>('.loc-v5-arrow--next');
    const bar = document.querySelector<HTMLElement>('.loc-v5-progress i');
    const step = () => cards[0].offsetWidth + (parseFloat(getComputedStyle(track).columnGap) || 0);
    const paint = () => {
      const max = track.scrollWidth - track.clientWidth;
      if (max <= 2) return; // desktop: grade, sem rolagem
      const atEnd = track.scrollLeft >= max - 2;
      const i = atEnd ? cards.length - 1 : Math.round(track.scrollLeft / step());
      if (bar) bar.style.width = `${((i + 1) / cards.length) * 100}%`;
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = atEnd;
    };
    track.addEventListener('scroll', paint, { passive: true });
    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    paint();
    window.addEventListener('resize', paint);
    window.addEventListener('load', paint);
  })();

  // ── Serviços: abas (clique e setas do teclado) trocam o painel; cada painel
  // tem um carrossel de fotos (setas + contador, volta ao início no fim)
  (() => {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.serv-v5-tab')];
    if (!tabs.length) return;
    const pad = (v: number) => String(v).padStart(2, '0');

    document.querySelectorAll<HTMLElement>('.serv-v5-media').forEach((media) => {
      const track = media.querySelector<HTMLElement>('.serv-v5-track')!;
      const n = track.children.length;
      const count = media.querySelector<HTMLElement>('.serv-v5-count');
      const idx = () => Math.round(track.scrollLeft / (track.clientWidth || 1));
      const go = (i: number) => {
        const target = ((i % n) + n) % n;
        track.scrollTo({ left: target * track.clientWidth, behavior: 'smooth' });
      };
      track.addEventListener('scroll', () => {
        if (count) count.textContent = `${pad(Math.min(n, idx() + 1))} / ${pad(n)}`;
      }, { passive: true });
      media.querySelector('.serv-v5-arrow--prev')?.addEventListener('click', () => go(idx() - 1));
      media.querySelector('.serv-v5-arrow--next')?.addEventListener('click', () => go(idx() + 1));
    });

    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(tabs[(i + d + tabs.length) % tabs.length], true);
      });
    });
  })();

  // ── Popup "Orçamento online": abre pelo botão da faixa de CTA e pelos
  // "Solicitar orçamento" dos carrosséis de salas; fecha no X, no
  // Esc ou clicando fora; o envio é do forms.ts (validação, webhook, tracking)
  initForms();
  (() => {
    const modal = document.getElementById('orcamentoModal') as HTMLDialogElement | null;
    if (!modal) return;
    const lenis = (window as any).__lenis;
    const open = () => { modal.showModal(); document.documentElement.style.overflow = 'hidden'; lenis?.stop(); };
    const close = () => { modal.close(); };
    modal.addEventListener('close', () => { document.documentElement.style.overflow = ''; lenis?.start(); });
    document.querySelectorAll('[data-open-orcamento]').forEach((b) => b.addEventListener('click', open));
    modal.querySelector('[data-close-orcamento]')?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    const cupomToggle = modal.querySelector<HTMLInputElement>('#orcCupomToggle');
    const cupom = modal.querySelector<HTMLElement>('.orc-v5-cupom');
    cupomToggle?.addEventListener('change', () => { if (cupom) cupom.hidden = !cupomToggle.checked; });
  })();

  // ── Visualizador de fotos: clicar numa foto de "Espaço completo", Gastronomia
  // ou Galeria abre em tela cheia; setas, teclado e swipe passam para a
  // anterior/próxima da mesma seção
  (() => {
    const lb = byId('lightbox');
    if (!lb) return;
    const lbImg = lb.querySelector<HTMLImageElement>('.lightbox-img')!;
    const counter = lb.querySelector<HTMLElement>('.lightbox-count')!;
    const closeBtn = lb.querySelector<HTMLButtonElement>('.lightbox-close')!;
    const lenis = (window as any).__lenis;
    let list: HTMLImageElement[] = [];
    let index = 0;
    let lastFocus: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + list.length) % list.length;
      const img = list[index];
      lbImg.src = img.dataset.full || img.currentSrc || img.src;
      lbImg.alt = img.alt;
      counter.textContent = `${index + 1} / ${list.length}`;
    };
    const open = (imgs: HTMLImageElement[], i: number) => {
      list = imgs;
      lastFocus = document.activeElement as HTMLElement | null;
      show(i);
      lb.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      lenis?.stop();
      closeBtn.focus();
    };
    const close = () => {
      lb.hidden = true;
      lbImg.removeAttribute('src');
      document.documentElement.style.overflow = '';
      lenis?.start();
      lastFocus?.focus();
    };

    ['.ambientes-item', '.gastro-v3-item', '.galeria-item'].forEach((sel) => {
      const items = [...document.querySelectorAll<HTMLElement>(sel)];
      const imgs = items.map((el) => el.querySelector('img')).filter((img): img is HTMLImageElement => !!img);
      items.forEach((el, i) => {
        el.setAttribute('role', 'button');
        el.tabIndex = 0;
        el.setAttribute('aria-label', `Ampliar foto: ${imgs[i]?.alt ?? ''}`);
        el.addEventListener('click', () => open(imgs, i));
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(imgs, i); }
        });
      });
    });

    // Carrosséis "Salas e formatos" e fotos de cada serviço: cada carrossel é
    // uma lista própria
    document.querySelectorAll<HTMLElement>('.salas-v5-track, .serv-v5-track').forEach((track) => {
      const items = [...track.querySelectorAll<HTMLElement>('.salas-v5-slide, .serv-v5-slide')];
      const imgs = items.map((el) => el.querySelector('img')).filter((img): img is HTMLImageElement => !!img);
      items.forEach((el, i) => {
        el.setAttribute('role', 'button');
        el.tabIndex = 0;
        el.setAttribute('aria-label', `Ampliar foto: ${imgs[i]?.alt ?? ''}`);
        el.addEventListener('click', () => open(imgs, i));
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(imgs, i); }
        });
      });
    });

    lb.querySelector('.lightbox-prev')?.addEventListener('click', () => show(index - 1));
    lb.querySelector('.lightbox-next')?.addEventListener('click', () => show(index + 1));
    closeBtn.addEventListener('click', close);
    lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    lb.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
    });
  })();
</script>

