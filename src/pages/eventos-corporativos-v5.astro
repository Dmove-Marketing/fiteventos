---
// Gerado a partir de: debutantes.html
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import '../styles/eventos-corporativos-v5.css';

// Hero: imagem = 1º frame do vídeo de fundo, então a troca foto → vídeo não aparece.
// Uma imagem só (desktop e mobile, recortada via object-fit), em algumas larguras.
import heroFrameSrc from '../assets/images/hero-corporativo-v5.jpg';
const heroFrame = await getImage({ src: heroFrameSrc, widths: [640, 960, 1280], quality: 78 });
---

<Base
  title="Eventos Corporativos – Espaço Fit Eventos"
  description="Salas e auditórios para eventos corporativos em São Paulo: treinamentos, convenções, workshops e confraternizações, a 650 m da Estação Granja Julieta, com o melhor custo x benefício da região."
  ogImage="/images/novo_logo.png"
  waHideEmail={true}
  waFixedTipoEvento="Corporativo"
>
  <Fragment slot="head">
    <link rel="preload" as="image" imagesrcset={heroFrame.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
    <!-- Raleway: fonte da seção "Eventos Corporativos" (a mesma do site principal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;700;800&display=swap" />
    <!-- Fontes (só v3): os pesos 500 e 600 reaproveitam os arquivos do 400 e do
         700, que a página já baixa — 2 downloads de ~36KB a menos. Fica no slot
         "head", depois dos @font-face do Base, então estas regras prevalecem -->
    <style is:inline>
      @font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/Inter-400-latin.s.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/Inter-700-latin.s.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    </style>
  </Fragment>

    <section class="hero">
        <div id="hero-slides">
            <div class="hero-slide active">
                <img src={heroFrame.src} srcset={heroFrame.srcSet.attribute} sizes="100vw" width="1280" height="720" alt="" loading="eager" fetchpriority="high" decoding="async" />
                <!-- Vídeo de fundo (mesmo do site principal). A foto acima fica por baixo
                     como LCP/fallback; o vídeo aparece com fade quando começa a tocar -->
                <video class="hero-video" poster={heroFrame.src} src="https://espacofiteventos.com.br/wp-content/uploads/videspaco2024.mp4" autoplay muted loop playsinline preload="auto" aria-hidden="true" onplaying="this.classList.add('is-playing')"></video>
            </div>
        </div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-logo">
                <Img src="b6141e8a-26b2-4a98-a24a-572b061dd41b.png" alt="Espaço Fit Eventos" width={480} priority />
            </div>
            <h1 class="hero-title">O espaço ideal para<br><em>eventos corporativos</em></h1>
            <div class="hero-actions">
                <a href="#contato" class="btn-primary">Solicitar contato</a>
            </div>
        </div>
    </section>


    <section class="sobre">
        <!-- Vídeo do YouTube (Tour Virtual) tocando como vídeo de fundo: mudo, em loop,
             sem controles e sem cliques (nada do YouTube aparece). O player só é
             carregado quando a seção entra na tela; pausa ao sair (ver JS da v5) -->
        <div class="sobre-media sobre-media--yt">
            <div class="sobre-yt" data-yt-id="2wS41g9XZz4" style="background-image: url('https://i.ytimg.com/vi/2wS41g9XZz4/maxresdefault.jpg')" aria-label="Tour Virtual | Espaço Fit Eventos" role="img"></div>
        </div>
        <div class="sobre-content" style="opacity:0;transform:translateY(24px);transition:opacity .8s,transform .8s">
            <h2 class="section-title"><em>Espaço Fit Eventos</em></h2>
            <p class="section-body">Considerado um dos melhores <b>Espaços para Eventos Corporativos em SP</b>, o Espaço Fit Eventos foi lançado em 2012, com o propósito de oferecer aos seus clientes atendimento de qualidade e a melhor experiência em Serviços de Eventos Corporativos.</p>
            <!-- Selo Google 4.7: 4 estrelas cheias + a última 70% preenchida (3/10 apagada).
                 --fill 58%: um pouco abaixo dos 70% reais, p/ a parte apagada ficar visível no tamanho pequeno -->
            <div class="sobre-google" role="img" aria-label="Nota 4.7 de 5 no Google">
                <svg class="sobre-google-g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                <span class="sobre-google-nota">4.7</span>
                <span class="sobre-google-stars">
                    <span class="sobre-google-star"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z"/></svg></span>
                    <span class="sobre-google-star"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z"/></svg></span>
                    <span class="sobre-google-star"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z"/></svg></span>
                    <span class="sobre-google-star"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z"/></svg></span>
                    <span class="sobre-google-star sobre-google-star--parcial" style="--fill: 58%"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z"/></svg><span class="sobre-google-star-fill"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96z"/></svg></span></span>
                </span>
            </div>
            <a href="#contato" class="btn-primary sobre-cta">Solicitar contato</a>
        </div>
    </section>

    <!-- Salas / Eventos corporativos: as 4 categorias do site principal
         (espacofiteventos.com.br) no formato "Proposta 2": setas + contador ao lado
         do título, fotos inteiras (7:5, sem corte) e barra de progresso.
         Fotos em src/assets/images/corporativo-v5 -->
    <section class="salas-v5" id="salas">
        <div class="salas-v5-header">
            <span class="salas-v5-kicker">Salas e formatos</span>
            <h2 class="salas-v5-heading">Estrutura completa para<br><em>eventos corporativos</em></h2>
        </div>
        <div class="salas-v5-block">
            <div class="salas-v5-row">
                <div class="salas-v5-heads">
                    <h3 class="salas-v5-title">17 SALAS DIFERENCIADAS</h3>
                    <p class="salas-v5-sub">Para Eventos Corporativos Diferentes</p>
                </div>
                <div class="salas-v5-ctrl">
                    <button type="button" class="salas-v5-link" data-open-orcamento>Solicitar orçamento <span aria-hidden="true">→</span></button>
                    <span class="salas-v5-count" aria-live="polite">01 / 14</span>
                    <button class="salas-v5-arrow salas-v5-arrow--prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
                    <button class="salas-v5-arrow salas-v5-arrow--next" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
                </div>
            </div>
            <!-- palco da faixa: no celular as setas ficam sobre as fotos (ver CSS) -->
            <div class="salas-v5-stage">
            <button class="salas-v5-arrow salas-v5-arrow--prev salas-v5-float" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="salas-v5-arrow salas-v5-arrow--next salas-v5-float" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
            <div class="salas-v5-track">
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-01.webp" alt="Sala high tech com iluminação hexagonal – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-02.webp" alt="Sala VIP com sofás – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-03.webp" alt="Sala com painel de LED – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-04.webp" alt="Sala high tech – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-05.webp" alt="Sala de streaming – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-06.webp" alt="Sala de design thinking – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-07.webp" alt="Salas modernas – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-08.webp" alt="Salão para até 530 pessoas – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-09.webp" alt="Camarim – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-10.webp" alt="Sala de reunião – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-11.webp" alt="Sala de confraternização – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-12.webp" alt="Sala de coffee break – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-13.webp" alt="Sala instagramável – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/salas/salas-14.webp" alt="Sala com projeção mapeada – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
            </div>
            </div>
            <div class="salas-v5-progress" aria-hidden="true"><i></i></div>
        </div>
        <div class="salas-v5-block">
            <div class="salas-v5-row">
                <div class="salas-v5-heads">
                    <h3 class="salas-v5-title">SALAS E AUDITÓRIOS</h3>
                    <p class="salas-v5-sub">Layouts para Eventos de 10 a 530 pessoas</p>
                </div>
                <div class="salas-v5-ctrl">
                    <button type="button" class="salas-v5-link" data-open-orcamento>Solicitar orçamento <span aria-hidden="true">→</span></button>
                    <span class="salas-v5-count" aria-live="polite">01 / 10</span>
                    <button class="salas-v5-arrow salas-v5-arrow--prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
                    <button class="salas-v5-arrow salas-v5-arrow--next" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
                </div>
            </div>
            <!-- palco da faixa: no celular as setas ficam sobre as fotos (ver CSS) -->
            <div class="salas-v5-stage">
            <button class="salas-v5-arrow salas-v5-arrow--prev salas-v5-float" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="salas-v5-arrow salas-v5-arrow--next salas-v5-float" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
            <div class="salas-v5-track">
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-01.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-02.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-03.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-04.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-05.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-06.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-07.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-08.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-09.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/auditorios/auditorios-10.webp" alt="Sala e auditório para eventos corporativos – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
            </div>
            </div>
            <div class="salas-v5-progress" aria-hidden="true"><i></i></div>
        </div>
        <div class="salas-v5-block">
            <div class="salas-v5-row">
                <div class="salas-v5-heads">
                    <h3 class="salas-v5-title">EVENTOS HÍBRIDOS OU ONLINE</h3>
                    <p class="salas-v5-sub">Internet Dedicada, Painéis LED e Projeção Mapeada</p>
                </div>
                <div class="salas-v5-ctrl">
                    <button type="button" class="salas-v5-link" data-open-orcamento>Solicitar orçamento <span aria-hidden="true">→</span></button>
                    <span class="salas-v5-count" aria-live="polite">01 / 09</span>
                    <button class="salas-v5-arrow salas-v5-arrow--prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
                    <button class="salas-v5-arrow salas-v5-arrow--next" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
                </div>
            </div>
            <!-- palco da faixa: no celular as setas ficam sobre as fotos (ver CSS) -->
            <div class="salas-v5-stage">
            <button class="salas-v5-arrow salas-v5-arrow--prev salas-v5-float" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="salas-v5-arrow salas-v5-arrow--next salas-v5-float" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
            <div class="salas-v5-track">
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-01.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-02.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-03.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-04.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-05.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-06.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-07.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-08.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/hibridos/hibridos-09.webp" alt="Estrutura para evento híbrido ou online – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
            </div>
            </div>
            <div class="salas-v5-progress" aria-hidden="true"><i></i></div>
        </div>
        <div class="salas-v5-block">
            <div class="salas-v5-row">
                <div class="salas-v5-heads">
                    <h3 class="salas-v5-title">FESTA DE CONFRATERNIZAÇÃO</h3>
                    <p class="salas-v5-sub">Coffee Break, Almoço, Coquetel e Festas de Confraternização</p>
                </div>
                <div class="salas-v5-ctrl">
                    <button type="button" class="salas-v5-link" data-open-orcamento>Solicitar orçamento <span aria-hidden="true">→</span></button>
                    <span class="salas-v5-count" aria-live="polite">01 / 20</span>
                    <button class="salas-v5-arrow salas-v5-arrow--prev" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
                    <button class="salas-v5-arrow salas-v5-arrow--next" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
                </div>
            </div>
            <!-- palco da faixa: no celular as setas ficam sobre as fotos (ver CSS) -->
            <div class="salas-v5-stage">
            <button class="salas-v5-arrow salas-v5-arrow--prev salas-v5-float" type="button" aria-label="Foto anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button class="salas-v5-arrow salas-v5-arrow--next salas-v5-float" type="button" aria-label="Próxima foto"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
            <div class="salas-v5-track">
                    <div class="salas-v5-slide"><Img src="corporativo-v5/confraternizacao/confraternizacao-02.webp" alt="Festa de confraternização de empresa – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/confraternizacao/confraternizacao-03.webp" alt="Festa de confraternização de empresa – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
                    <div class="salas-v5-slide"><Img src="corporativo-v5/confraternizacao/confraternizacao-04.webp" alt="Festa de confraternização de empresa – Espaço Fit Eventos" width={720} quality={72} zoom /></div>
