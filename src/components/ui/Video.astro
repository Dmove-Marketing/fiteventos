---
interface Props {
  /** URL pública do .mp4 (VPS ou CDN) */
  src: string;
  /** Imagem de poster — use o componente Img ou uma URL */
  poster: string;
  /** Título do vídeo — obrigatório para o VideoObject (SEO) */
  title: string;
  /** Descrição curta para o schema */
  description?: string;
  /** Data de upload ISO 8601 */
  uploadDate?: string;
  /** Duração ISO 8601 (ex: "PT2M30S" = 2min30s) */
  duration?: string;
  /** Mostra controles nativos após play (padrão: true) */
  controls?: boolean;
  /** Modo reels: autoplay mudo + loop ao entrar na tela, toque para ouvir */
  autoplay?: boolean;
  /** Proporção do quadro (ex: "9 / 16" p/ vídeo vertical). Padrão 16/9. */
  aspect?: string;
  class?: string;
}

const {
  src,
  poster,
  title,
  description = '',
  uploadDate,
  duration,
  controls = true,
  autoplay = false,
  aspect = '16 / 9',
  class: className,
} = Astro.props;

const videoId = `video-${Math.random().toString(36).slice(2, 8)}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  contentUrl: src,
  thumbnailUrl: poster,
  ...(uploadDate && { uploadDate }),
  ...(duration && { duration }),
};
---

<div class:list={['video-wrap', autoplay && 'video-wrap--reels', className]} id={videoId} style={`aspect-ratio:${aspect}`}>
  <video
    class="video-wrap__player"
    poster={poster}
    preload="none"
    playsinline
    muted={autoplay}
    loop={autoplay}
    controls={autoplay ? false : controls}
    data-src={src}
    aria-label={title}
  >
    <source data-src={src} type="video/mp4" />
    Seu navegador não suporta vídeo HTML5.
  </video>

  {autoplay ? (
    <button class="video-wrap__sound" type="button" aria-label="Ativar som">
      <svg class="video-wrap__sound-icon video-wrap__sound-icon--off" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4.03v8.05A4.5 4.5 0 0 0 16.5 12z"/>
        <path d="M19 5 5 19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
      </svg>
      <svg class="video-wrap__sound-icon video-wrap__sound-icon--on" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4.03v8.05A4.5 4.5 0 0 0 16.5 12zM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54z"/>
      </svg>
      <span class="video-wrap__sound-label">Toque para ouvir</span>
    </button>
  ) : (
    <button class="video-wrap__play" type="button" aria-label={`Reproduzir ${title}`}>
      <svg viewBox="0 0 80 80" width="72" height="72" aria-hidden="true">
        <circle cx="40" cy="40" r="40" fill="rgba(0,0,0,.55)"/>
        <polygon points="32,22 62,40 32,58" fill="#fff"/>
      </svg>
    </button>
  )}
</div>

<script define:vars={{ videoId, autoplay }}>
  const wrap = document.getElementById(videoId);
  if (!wrap) throw new Error();

  const video = wrap.querySelector('video');
  const source = video.querySelector('source');

  const load = () => {
    if (!video.src) {
      video.src = video.dataset.src;
      source.src = source.dataset.src;
      video.load();
    }
  };

  if (autoplay) {
    // Modo reels: toca sozinho (mudo) quando visível; pausa fora da tela; toque = som
    const soundBtn = wrap.querySelector('.video-wrap__sound');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { load(); video.play().catch(() => {}); }
        else { video.pause(); }
      });
    }, { threshold: 0.35 });
    observer.observe(wrap);

    const toggleSound = () => {
      video.muted = !video.muted;
      if (!video.muted) video.play().catch(() => {});
      wrap.classList.toggle('is-unmuted', !video.muted);
      soundBtn.setAttribute('aria-label', video.muted ? 'Ativar som' : 'Silenciar');
    };
    video.addEventListener('click', toggleSound);
    soundBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleSound(); });
  } else {
    // Modo padrão: clique para tocar
    const btn = wrap.querySelector('.video-wrap__play');
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) { load(); observer.disconnect(); }
    }, { rootMargin: '200px' });
    observer.observe(wrap);

    btn.addEventListener('click', () => { load(); video.play(); btn.style.display = 'none'; });
    video.addEventListener('pause', () => { btn.style.display = ''; });
    video.addEventListener('ended', () => { btn.style.display = ''; });
  }
</script>

<!-- VideoObject para indexação do Google -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .video-wrap {
    position: relative;
    background: #000;
    overflow: hidden;
    border-radius: inherit;
    aspect-ratio: 16 / 9;
  }
  .video-wrap__player {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .video-wrap--reels .video-wrap__player { cursor: pointer; }
  .video-wrap__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 72px;
    height: 72px;
    background: none;
    border: none;
    cursor: pointer;
    transition: transform .15s, opacity .15s;
  }
  .video-wrap__play:hover { transform: scale(1.1); opacity: .9; }

  /* Pill "toque para ouvir" (modo reels) */
  .video-wrap__sound {
    position: absolute;
    bottom: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(0, 0, 0, .55);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .35);
    border-radius: 100px;
    padding: 8px 14px;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: .3px;
    cursor: pointer;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: background .2s;
    z-index: 2;
  }
  .video-wrap__sound:hover { background: rgba(0, 0, 0, .72); }
  .video-wrap__sound-icon--on { display: none; }
  .video-wrap.is-unmuted .video-wrap__sound-icon--off { display: none; }
  .video-wrap.is-unmuted .video-wrap__sound-icon--on { display: inline; }
  .video-wrap.is-unmuted .video-wrap__sound-label { display: none; }
</style>
