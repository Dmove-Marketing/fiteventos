---
import { Image, getImage } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** true = eager + fetchpriority high (use na imagem LCP/hero) */
  priority?: boolean;
  /** true = renderiza data-src (sem baixar) — JS carrega sob demanda (ex.: slides de carrossel não-ativos) */
  defer?: boolean;
  quality?: number;
  class?: string;
  style?: string;
}

const {
  src,
  alt,
  width = 1200,
  height,
  priority = false,
  defer = false,
  quality = 80,
  class: className,
  style,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const key = `/src/assets/images/${src}`;
const mod = images[key];

if (!mod) {
  console.warn(`[Img] imagem não encontrada: ${key}`);
}

// Modo defer: gera a URL otimizada mas NÃO baixa (fica em data-src). Usado nos
// slides não-ativos do hero para não puxar 6 imagens no primeiro load.
const deferred = defer && mod ? await getImage({ src: mod.default, width, height, quality }) : null;
const blankPixel = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---

{deferred ? (
  <img
    src={blankPixel}
    data-src={deferred.src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    class={className}
    style={style}
  />
) : mod ? (
  <Image
    src={mod.default}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    quality={quality}
    class={className}
    style={style}
  />
) : (
  <img
    src=""
    alt={alt}
    width={width}
    height={height ?? undefined}
    class={className}
    style={style}
    data-placeholder={key}
    aria-hidden="true"
  />
)}
