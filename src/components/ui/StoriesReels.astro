---
// Stories navegável (estilo Instagram/reels): vários clipes curtos, barras de
// progresso no topo, autoplay mudo, toque à direita avança / à esquerda volta,
// toque no botão ativa o som. Cada clipe carrega sob demanda (o 1º no autoplay).
interface Clip { src: string; }
interface Props {
  clips: Clip[];
  poster: string;
  title?: string;
  /** proporção do quadro; padrão 9/16 (vertical) */
  aspect?: string;
  class?: string;
}
const { clips, poster, title = 'Vídeo', aspect = '9 / 16', class: className } = Astro.props;
const id = `stories-${Math.random().toString(36).slice(2, 8)}`;
const srcs = clips.map((c) => c.src);
---

<div class:list={['stories', className]} id={id} style={`aspect-ratio:${aspect}`}>
  <div class="stories__bars" aria-hidden="true">
    {clips.map(() => (
      <div class="stories__bar"><i class="stories__bar-fill"></i></div>
    ))}
  </div>

  <video class="stories__video" poster={poster} preload="none" playsinline muted aria-label={title}></video>

  <button class="stories__zone stories__zone--prev" type="button" aria-label="Trecho anterior"></button>
  <button class="stories__zone stories__zone--next" type="button" aria-label="Próximo trecho"></button>

  <button class="stories__sound" type="button" aria-label="Ativar som">
    <svg class="stories__ic stories__ic--off" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
      <path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M19 5 5 19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/>
    </svg>
    <svg class="stories__ic stories__ic--on" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
      <path d="M3 9v6h4l5 5V4L7 9H3zm11-1a5 5 0 0 1 0 8z"/><path d="M14 3.2a9 9 0 0 1 0 17.6v-2.1a7 7 0 0 0 0-13.4z"/>
    </svg>
    <span class="stories__sound-label">Toque para ouvir</span>
  </button>

  <button class="stories__play" type="button" aria-label="Assistir" hidden>
    <svg viewBox="0 0 80 80" width="66" height="66" aria-hidden="true">
      <circle cx="40" cy="40" r="40" fill="rgba(0,0,0,.55)"/><polygon points="32,22 62,40 32,58" fill="#fff"/>
    </svg>
  </button>
</div>

<script define:vars={{ id, srcs }}>
  const root = document.getElementById(id);
  if (root) {
    const video = root.querySelector('.stories__video');
    const bars = root.querySelectorAll('.stories__bar-fill');
    const soundBtn = root.querySelector('.stories__sound');
    const playBtn = root.querySelector('.stories__play');
    let idx = 0, unmuted = false, raf = 0, started = false;

    const setBar = (i, pct) => { if (bars[i]) bars[i].style.width = pct + '%'; };
    const paintBars = () => bars.forEach((_, i) => setBar(i, i < idx ? 100 : 0));

    const tick = () => {
      if (video.duration) setBar(idx, Math.min(100, (video.currentTime / video.duration) * 100));
      raf = requestAnimationFrame(tick);
    };
    const stopTick = () => { if (raf) cancelAnimationFrame(raf); raf = 0; };

    const prefetchNext = () => {
      const url = srcs[(idx + 1) % srcs.length];
      if (!url || document.querySelector(`link[data-vp="${url}"]`)) return;
      const l = document.createElement('link');
      l.rel = 'prefetch'; l.as = 'video'; l.href = url; l.setAttribute('data-vp', url);
      document.head.appendChild(l);
    };

    const load = (i) => {
      idx = (i + srcs.length) % srcs.length;
      video.src = srcs[idx];
      video.muted = !unmuted;
      video.load();
      paintBars();
      video.play().then(() => { playBtn.hidden = true; }).catch(() => { playBtn.hidden = false; });
      prefetchNext();
    };
    const next = () => load(idx + 1);
    const prev = () => load(idx - 1);

    video.addEventListener('ended', next);
    video.addEventListener('play', () => { playBtn.hidden = true; if (!raf) tick(); });
    video.addEventListener('pause', stopTick);

    root.querySelector('.stories__zone--next').addEventListener('click', next);
    root.querySelector('.stories__zone--prev').addEventListener('click', prev);

    const toggleSound = () => {
      unmuted = !unmuted;
      video.muted = !unmuted;
      if (unmuted) video.play().catch(() => {});
      root.classList.toggle('is-unmuted', unmuted);
      soundBtn.setAttribute('aria-label', unmuted ? 'Silenciar' : 'Ativar som');
    };
    soundBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleSound(); });
    playBtn.addEventListener('click', () => {
      unmuted = true; video.muted = false;
      root.classList.add('is-unmuted');
      video.play().then(() => { playBtn.hidden = true; }).catch(() => {});
    });

    // Toca quando visível; pausa fora da tela. Primeiro clipe carrega no 1º intersect.
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          if (!started) { started = true; load(0); }
          else video.play().catch(() => { playBtn.hidden = false; });
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.4 });
    io.observe(root);
  }
</script>

<style>
  .stories {
    position: relative;
    background: #000;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 9 / 16;
  }
  .stories__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Barras de progresso (topo) */
  .stories__bars {
    position: absolute;
    top: 0; left: 0; right: 0;
    display: flex;
    gap: 4px;
    padding: 12px 12px 0;
    padding-top: calc(12px + env(safe-area-inset-top, 0px));
    z-index: 4;
    pointer-events: none;
  }
  .stories__bar {
    flex: 1;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, .35);
    overflow: hidden;
  }
  .stories__bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: #fff;
    border-radius: 3px;
  }

  /* Zonas de toque (esquerda volta / direita avança) */
  .stories__zone {
    position: absolute;
    top: 0; bottom: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
  }
  .stories__zone--prev { left: 0; width: 32%; }
  .stories__zone--next { right: 0; width: 68%; }

  /* Pill "toque para ouvir" (topo-direita, estilo Stories) */
  .stories__sound {
    position: absolute;
    top: calc(20px + env(safe-area-inset-top, 0px));
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(0, 0, 0, .5);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .35);
    border-radius: 100px;
    padding: 7px 13px;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: .3px;
    cursor: pointer;
    z-index: 5;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: stories-pulse 2s ease-in-out infinite;
  }
  .stories__sound:hover { background: rgba(0, 0, 0, .68); }
  .stories__ic--on { display: none; }
  .stories.is-unmuted .stories__ic--off { display: none; }
  .stories.is-unmuted .stories__ic--on { display: inline; }
  .stories.is-unmuted .stories__sound-label { display: none; }
  .stories.is-unmuted .stories__sound { animation: none; }

  @keyframes stories-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, .0); transform: scale(1); }
    50%      { box-shadow: 0 0 0 6px rgba(255, 255, 255, .12); transform: scale(1.04); }
  }

  .stories__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 66px;
    height: 66px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 6;
  }

  @media (prefers-reduced-motion: reduce) {
    .stories__sound { animation: none; }
  }
</style>
